    <decisions>
        <name>Check_the_created_Timing</name>
        <label>Check the created Timing</label>
        <locationX>796</locationX>
        <locationY>671</locationY>
        <defaultConnector>
            <targetReference>Create_task_at_10AM</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>After 4PM</defaultConnectorLabel>
        <rules>
            <name>Created_Timing_before_4PM</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>HourofCreatedTimeFormula</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>10.5</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_task_at_5PM</targetReference>
            </connector>
            <label>Before 4PM</label>
        </rules>
    </decisions>
    <description>created from v10: removing IndiaMart fields
Lead Created task time change 2 to 4 
Subject from New Call to New Phone call
Subtask call type
Changed 9AM to 10AM
Subject of Task has been changed</description>
    <environments>Default</environments>
    <formulas>
        <name>FollowupDateTimeAt10AMnextdayFormula</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(
  TEXT(DATEVALUE({!$Record.CreatedDate}) + 1) &amp; &quot; 04:30:00&quot;
)</expression>
    </formulas>
    <formulas>
        <name>FollowupDateTimeAt5PMFormula</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(
  TEXT(DATEVALUE({!$Record.CreatedDate})) &amp; &quot; 11:30:00&quot;
)</expression>
    </formulas>
    <formulas>
        <name>Formula_Country</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.indiaMartConfig__SenderCountryISO__c} = &quot;IN&quot;, &quot;India&quot;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>Formula_State_NoSpaces</name>
        <dataType>String</dataType>
        <expression>CASE(
UPPER(SUBSTITUTE(TRIM({!$Record.indiaMartConfig__SenderState__c}), &quot; &quot;, &quot;&quot;)),
