&quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>HourofCreatedTimeFormula</name>
        <dataType>Number</dataType>
        <expression>HOUR(TIMEVALUE({!$Record.CreatedDate}))
+
(
    MINUTE(TIMEVALUE({!$Record.CreatedDate})) / 60
)</expression>
        <scale>0</scale>
    </formulas>
