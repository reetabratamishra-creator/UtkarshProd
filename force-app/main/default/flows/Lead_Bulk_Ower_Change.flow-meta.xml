    <formulas>
        <name>Is_Running_User_Authorized</name>
        <dataType>Boolean</dataType>
        <expression>OR(
    {!Get_Running_User.Profile.Name} = &quot;System Administrator&quot;,
    {!Get_Running_User.Profile.Name} = &quot;Utkarsh Admin&quot;,
    {!Get_Running_User.Profile.Name} = &quot;CRM Head&quot;,
    {!Get_Running_User.Profile.Name} = &quot;Utkarsh HOD&quot;

)</expression>
    </formulas>
    <formulas>
        <name>Is_Running_User_Dept_Match</name>
        <dataType>Boolean</dataType>
        <expression>OR(
    {!Get_Running_User.Profile.Name} = &quot;System Administrator&quot;,
    {!Get_Running_User.Profile.Name} = &quot;Utkarsh Admin&quot;,
{!Get_Running_User.Profile.Name} = &quot;CRM Head&quot;,
    {!Get_Running_User.Profile.Name} = &quot;Utkarsh HOD&quot;,
    AND({!First_Dept} = &quot;Crash Barrier&quot;, INCLUDES({!Get_Running_User.Departments__c}, &quot;Crash_Barrier_Department&quot;)),
    AND({!First_Dept} = &quot;High Mast &amp; Polygonal&quot;, INCLUDES({!Get_Running_User.Departments__c}, &quot;High_Mast_Department&quot;)),
    AND({!First_Dept} = &quot;Solar Structure&quot;, INCLUDES({!Get_Running_User.Departments__c}, &quot;Solar_Structure_Department&quot;)),
    AND({!First_Dept} = &quot;Steel Pipes&quot;, INCLUDES({!Get_Running_User.Departments__c}, &quot;Steel_Pipes_Department&quot;)),
    AND({!First_Dept} = &quot;Steel Tubular Poles&quot;, INCLUDES({!Get_Running_User.Departments__c}, &quot;Steel_Tubular_Pole_Department&quot;)),
    AND({!First_Dept} = &quot;Transmission &amp; Telecom Tower&quot;, INCLUDES({!Get_Running_User.Departments__c}, &quot;Transmission_Tower_Department&quot;))
)</expression>
    </formulas>
    <formulas>
        <name>IsUserDeptMismatched</name>
        <dataType>Boolean</dataType>
        <expression>NOT(CONTAINS({!$User.Department}, {!Loop_Check_Departments.Department_NameFormula__c}))</expression>
    </formulas>
    <formulas>
        <name>Mapped_Dept</name>
        <dataType>String</dataType>
        <expression>IF({!First_Dept} = &quot;Crash Barrier&quot;, &quot;Crash_Barrier_Department&quot;,
IF({!First_Dept} = &quot;High Mast &amp; Polygonal&quot;, &quot;High_Mast_Department&quot;,
IF({!First_Dept} = &quot;Solar Structure&quot;, &quot;Solar_Structure_Department&quot;,
IF({!First_Dept} = &quot;Steel Pipes&quot;, &quot;Steel_Pipes_Department&quot;,
IF({!First_Dept} = &quot;Steel Tubular Poles&quot;, &quot;Steel_Tubular_Pole_Department&quot;,
IF({!First_Dept} = &quot;Transmission &amp; Telecom Tower&quot;, &quot;Transmission_Tower_Department&quot;,
&quot;&quot;))))))</expression>
    </formulas>
