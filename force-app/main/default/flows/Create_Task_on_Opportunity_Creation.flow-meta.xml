    <decisions>
        <name>Check_the_created_Timing</name>
        <label>Check the created Timing</label>
        <locationX>537</locationX>
        <locationY>479</locationY>
        <defaultConnector>
            <targetReference>Create_task_at_10AM</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>After 2PM</defaultConnectorLabel>
        <rules>
            <name>Created_Timing_before_2PM</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>HourofCreatedTimeFormula</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>10.5</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_task_at_5PM</targetReference>
            </connector>
            <label>Before 2PM</label>
        </rules>
    </decisions>
    <decisions>
        <name>Recordtype</name>
        <label>Recordtype</label>
        <locationX>900</locationX>
        <locationY>367</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Master_Opportunity</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Master_Opportunity</stringValue>
                </rightValue>
            </conditions>
            <label>Master_Opportunity</label>
        </rules>
    </decisions>
    <description>created from v29-grammatical mistake 
Directly create task on Opportunity
Created from v1 only for task creation on Opportunity creation, subtype
changed 9AM to 10AM</description>
    <environments>Default</environments>
    <formulas>
        <name>FollowupDateTimeAt10AMnextdayFormula</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(
  TEXT(DATEVALUE({!$Record.CreatedDate}) + 1) &amp; &quot; 04:30:00&quot;
)</expression>
    </formulas>
    <formulas>
        <name>FollowupDateTimeAt5PMFormula</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(
  TEXT(DATEVALUE({!$Record.CreatedDate})) &amp; &quot; 11:30:00&quot;
)</expression>
    </formulas>
    <formulas>
        <name>HourofCreatedTimeFormula</name>
        <dataType>Number</dataType>
        <expression>HOUR(TIMEVALUE({!$Record.CreatedDate}))+(
    MINUTE(TIMEVALUE({!$Record.CreatedDate})) / 60
)</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Create Task on [Opportunity] Creation {!$Flow.CurrentDateTime}</interviewLabel>
