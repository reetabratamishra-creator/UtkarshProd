            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_related_lead.LeadSource</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Exotel</stringValue>
                </rightValue>
            </conditions>
            <label>check if task created by exotel</label>
        </rules>
        <rules>
