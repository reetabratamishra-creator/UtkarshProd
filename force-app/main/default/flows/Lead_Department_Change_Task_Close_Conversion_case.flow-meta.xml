    <decisions>
        <name>before_2_pm_or_after</name>
        <label>before 2 pm or after?</label>
        <locationX>381</locationX>
        <locationY>483</locationY>
        <defaultConnectorLabel>default</defaultConnectorLabel>
        <rules>
            <name>Before</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>HourofCurrentDateTimeTimeFormula</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>10.5</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_New_Task_for_new_Department_at_5pm</targetReference>
            </connector>
            <label>Before</label>
        </rules>
        <rules>
            <name>After</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>HourofCurrentDateTimeTimeFormula</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>10.5</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_New_Task_for_new_Department_at_10am</targetReference>
            </connector>
            <label>After</label>
        </rules>
    </decisions>
    <description>To stop departmnet change task coming from lead during conversion in opportunity</description>
