    <actionCalls>
        <name>Send_Email_to_ED_Sir</name>
        <label>Send Email to ED Sir</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>recipientAddresses</name>
            <value>
                <collectionElements>
                    <elementReference>Get_ED_Role_User.Email</elementReference>
                </collectionElements>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderType</name>
            <value>
                <inputConfiguratorMode>Custom</inputConfiguratorMode>
                <stringValue>OrgWideEmailAddress</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderAddress</name>
            <value>
                <inputConfiguratorMode>Custom</inputConfiguratorMode>
                <stringValue>indiateam+utkarshuat@halsaglobal.io</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>composeEmailContent</name>
            <value>
                <stringValue>True</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
                <stringValue>3rd Reminder for Case Escalation</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <inputConfiguratorMode>Custom</inputConfiguratorMode>
                <stringValue>Dear Sir/Madam,

This is to bring to your attention that Case {!$Record.CaseNumber} associated with the {!$Record.Department__c} department remains open and requires review.

Case Details:
• Case Number: {!$Record.CaseNumber}
• Department: {!$Record.Department__c}

We kindly request you to review the case and take the necessary action to ensure timely resolution.

Your attention and support in this matter are highly appreciated.

Thank you.</stringValue>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
        <offset>0</offset>
        <versionString>3.0.1</versionString>
    </actionCalls>
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_If_Escalation_Date_2_matches_Today</name>
        <label>Check If Escalation Date 2 matches Today</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isEscDate2Today</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_ED_Role</targetReference>
            </connector>
            <label>If Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>If_User_and_Role_Found</name>
        <label>If User and Role Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_User_is_Active_and_Email_not_Null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_ED_Role</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_ED_Role_User.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_ED_Role_User.Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Email_to_ED_Sir</targetReference>
            </connector>
            <label>If User is Active and Email not Null</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Today_Sunday</name>
        <label>Is Today Sunday ?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Check_If_Escalation_Date_2_matches_Today</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Sunday</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isSundayFor</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Is Sunday</label>
        </rules>
    </decisions>
    <description>This flow is scheduled to give a 3rd reminder to ED Sir as the triggering case didn&apos;t get response from many days.</description>
    <environments>Default</environments>
    <formulas>
        <name>crmUserRoleName</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.Department__c}) &amp; &quot; CRM User&quot;</expression>
    </formulas>
    <formulas>
        <name>hodRoleName</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.Department__c}) &amp; &quot; HOD&quot;</expression>
    </formulas>
    <formulas>
        <name>isEscDate2Today</name>
        <dataType>Boolean</dataType>
        <expression>TODAY() = DATEVALUE({!$Record.Escalation_Date_2__c})</expression>
    </formulas>
    <formulas>
        <name>isSundayFor</name>
        <dataType>Boolean</dataType>
        <expression>WEEKDAY(TODAY()) = 1</expression>
    </formulas>
    <interviewLabel>Case : 3rd Reminder to ED Sir for Escalation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case : 3rd Reminder to ED Sir for Escalation</label>
