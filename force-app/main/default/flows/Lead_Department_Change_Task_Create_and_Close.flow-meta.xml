    <decisions>
        <name>before_2_pm_or_after</name>
        <label>before 2 pm or after?</label>
        <locationX>365</locationX>
        <locationY>573</locationY>
        <defaultConnectorLabel>default</defaultConnectorLabel>
        <rules>
            <name>Before</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>HourofCurrentDateTimeTimeFormula</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>10.5</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.IsConverted</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_New_Task_for_new_Department_at_5pm</targetReference>
            </connector>
            <label>Before</label>
        </rules>
        <rules>
            <name>After</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>HourofCurrentDateTimeTimeFormula</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>10.5</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.IsConverted</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_New_Task_for_new_Department_at_10am</targetReference>
            </connector>
            <label>After</label>
        </rules>
    </decisions>
    <description>v16 created from v15 -  added InQualification checkbox in condition
v15 created from v14 - put AND condition for stage and changed notification body from Opportunity to Lead
v14 created from v13- added stage condition in the initial condition
v13 created from v12--  description changes for new tasks
v12-created from v13 -closing events during department change
v10-stop department change task when converting
v9-created from v7 for completed word to come up only once
Custom Notifcaiton on department change
Follow Up times for task to be changed from 2pm to 4pm
Subject Line and Description changed
Updating Task Subject with adding &quot;- completed&quot; in suffix 
Have put 5pm 10am timing for task</description>
    <environments>Default</environments>
    <formulas>
        <name>FollowupDateTimeAt10AMnextdayFormula</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(
  TEXT(DATEVALUE({!$Flow.CurrentDateTime}) + 1) &amp; &quot; 04:30:00&quot;
)</expression>
    </formulas>
    <formulas>
        <name>FollowupDateTimeAt5PMFormula</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(
  TEXT(DATEVALUE({!$Flow.CurrentDateTime})) &amp; &quot; 11:30:00&quot;
)</expression>
    </formulas>
    <formulas>
        <name>formulaTaskDescription</name>
        <dataType>String</dataType>
        <expression>{!Loop_Through_all_the_Tasks.Description}&amp;&apos;- Closed due to department change&apos;</expression>
    </formulas>
    <formulas>
        <name>HourofCurrentDateTimeTimeFormula</name>
        <dataType>Number</dataType>
        <expression>HOUR(TIMEVALUE({!$Flow.CurrentDateTime}))
+
(
    MINUTE(TIMEVALUE({!$Flow.CurrentDateTime})) / 60
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>updatedTaskSubject</name>
        <dataType>String</dataType>
        <expression>IF(
    CONTAINS({!Loop_Through_all_the_Tasks.Subject}, &quot;Completed&quot;),
    {!Loop_Through_all_the_Tasks.Subject},
    {!Loop_Through_all_the_Tasks.Subject} &amp; &quot; - Completed&quot;
)</expression>
    </formulas>
