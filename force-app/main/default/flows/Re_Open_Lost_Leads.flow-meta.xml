    <formulas>
        <name>FollowupDateTimeAt10AMnextdayFormula</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(
  TEXT(DATEVALUE({!$Flow.CurrentDateTime}) + 1) &amp; &quot; 04:30:00&quot;
)</expression>
    </formulas>
    <formulas>
        <name>FollowupDateTimeAt5PMFormula</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(
  TEXT(DATEVALUE({!$Flow.CurrentDateTime})) &amp; &quot; 11:30:00&quot;
)</expression>
    </formulas>
    <formulas>
        <name>HourofLastOpportunityModifiedTimeFormula</name>
        <dataType>Number</dataType>
        <expression>HOUR(TIMEVALUE({!$Flow.CurrentDateTime}))
+
(
    MINUTE(TIMEVALUE({!$Flow.CurrentDateTime}))
    / 60
)</expression>
        <scale>2</scale>
    </formulas>
