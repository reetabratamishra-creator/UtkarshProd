    <decisions>
        <name>before_4_pm_or_after</name>
        <label>before 4 pm or after?</label>
        <locationX>256</locationX>
        <locationY>454</locationY>
        <defaultConnector>
            <targetReference>Create_New_Task_for_new_Department_at_10am</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>After</defaultConnectorLabel>
        <rules>
            <name>Before</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>HourofCurrentDateTimeTimeFormula</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>10.5</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_New_Task_for_new_Department_at_5pm</targetReference>
            </connector>
            <label>Before</label>
        </rules>
    </decisions>
    <description>created from v13-- description changes for new tasks
created from v11 : now updating the opportunity related events . previously only task is updating
lead checking for task removed
completed word only if not already present-v10
Subject changed for new tasks-v9
Custom Notification for Department changed-v8
Follow up changed from 2:30 to 4 for task time -&gt; v4
Subject Line and Description changed
Adding &quot;- Completed&quot; as suffix in task subject when completed
have put 10am 5pm timing</description>
    <environments>Default</environments>
    <formulas>
        <name>Description_add_formula</name>
        <dataType>String</dataType>
        <expression>{!Loop_Through_all_the_Tasks.Description}&amp;&apos;- Closed due to department change&apos;</expression>
    </formulas>
    <formulas>
        <name>FollowupDateTimeAt10AMnextdayFormula</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(
  TEXT(DATEVALUE({!$Flow.CurrentDateTime}) + 1) &amp; &quot; 04:30:00&quot;
)</expression>
    </formulas>
    <formulas>
        <name>FollowupDateTimeAt5PMFormula</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(
  TEXT(DATEVALUE({!$Flow.CurrentDateTime})) &amp; &quot; 11:30:00&quot;
)</expression>
    </formulas>
    <formulas>
        <name>HourofCurrentDateTimeTimeFormula</name>
        <dataType>Number</dataType>
        <expression>HOUR(TIMEVALUE({!$Flow.CurrentDateTime}))
+
(
    MINUTE(TIMEVALUE({!$Flow.CurrentDateTime})) / 60
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>updatedTaskSubject</name>
        <dataType>String</dataType>
        <expression>IF(
    CONTAINS({!Loop_Through_all_the_Tasks.Subject}, &quot;Completed&quot;),
    {!Loop_Through_all_the_Tasks.Subject},
    {!Loop_Through_all_the_Tasks.Subject} &amp; &quot; - Completed&quot;
)</expression>
    </formulas>
