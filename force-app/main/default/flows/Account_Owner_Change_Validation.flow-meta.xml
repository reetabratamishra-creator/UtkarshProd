    <decisions>
        <name>check_department</name>
        <label>check department</label>
        <locationX>500</locationX>
        <locationY>459</locationY>
        <defaultConnector>
            <targetReference>assign_checkbox_0</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Same_Department_non_dealer</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Department_Name__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Owner.Department</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordTypeId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>get_RecordType.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Custom_Error</targetReference>
            </connector>
            <label>Same Department non dealer</label>
        </rules>
        <rules>
            <name>Same_Department_dealer</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>get_RecordType.Id</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Department_Name_MultiSelect__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>$Record.Owner.Department</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>assign_checkbox</targetReference>
            </connector>
            <label>Same Department dealer</label>
        </rules>
        <rules>
            <name>If_user_profile_is_admin_or_sys_admin</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Owner.Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>System Administrator</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner.Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Utkarsh Admin</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>assign_checkbox</targetReference>
            </connector>
            <label>If user profile is admin or sys admin</label>
        </rules>
    </decisions>
    <decisions>
