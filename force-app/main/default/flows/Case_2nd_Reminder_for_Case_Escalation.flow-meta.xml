        </rules>
    </decisions>
    <decisions>
        <name>Check_if_Escalation_Date_1_matches_Today</name>
        <label>Check if Escalation Date 1 matches Today</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isEsc1DateToday</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_HOD_User_Role</targetReference>
            </connector>
