        </rules>
    </decisions>
    <decisions>
        <name>Is_Today_Sunday</name>
        <label>Is Today Sunday ?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Check_if_Escalation_Date_1_matches_Today</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Sunday</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isSundayFor</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Is Sunday</label>
        </rules>
    </decisions>
    <description>This flow is scheduled to send an email notification to HOD and CRM User as because even after sending email to case owner at the first time no response given to the case.</description>
    <environments>Default</environments>
    <formulas>
        <name>crmUserRoleName</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.Department__c}) &amp; &quot; CRM User&quot;</expression>
    </formulas>
    <formulas>
        <name>hodRoleName</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.Department__c}) &amp; &quot; HOD&quot;</expression>
    </formulas>
    <formulas>
        <name>isEsc1DateToday</name>
        <dataType>Boolean</dataType>
        <expression>TODAY() = DATEVALUE({!$Record.Escalation_Date_1__c})</expression>
    </formulas>
    <formulas>
        <name>isSundayFor</name>
        <dataType>Boolean</dataType>
        <expression>WEEKDAY(TODAY()) = 1</expression>
    </formulas>
