    <environments>Default</environments>
    <formulas>
        <name>FollowupDateTimeAt10AMnextdayFormula</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(
  TEXT(DATEVALUE({!get_Updated_Existing_Task_Info.LastModifiedDate}) + 1) &amp; &quot; 04:30:00&quot;
)</expression>
    </formulas>
    <formulas>
        <name>FollowupDateTimeAt5PMFormula</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(
  TEXT(DATEVALUE({!get_Updated_Existing_Task_Info.LastModifiedDate})) &amp; &quot; 11:30:00&quot;
)</expression>
    </formulas>
    <formulas>
        <name>HourofLastTaskModifiedTimeFormula</name>
        <dataType>Number</dataType>
        <expression>HOUR(TIMEVALUE({!get_Updated_Existing_Task_Info.LastModifiedDate}))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>updateTaskSubject</name>
        <dataType>String</dataType>
        <expression>{!get_Task.Subject} &amp; &quot; - Completed&quot;</expression>
    </formulas>
