                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Company</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Company</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Company_Name__c</elementReference>
                </rightValue>
            </conditions>
