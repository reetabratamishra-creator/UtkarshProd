<apex:page standardController="Quote" extensions="SolarQuoteOfferController"
           renderAs="pdf" applyHtmlTag="false" showHeader="false" standardStylesheets="false">
<head>
<style type="text/css">
    /* 1. GLOBAL DEFAULT: 0mm margins, no headers (Perfect for covers) */
    @page {
        size: A4;
        margin: 0mm;
    }

    /* 2. NAMED PAGE: specifically for your standard document content */
    @page standard-content {
        size: A4;
        margin-top: 38mm;
        margin-bottom: 35mm; 
        margin-left: 14mm;
        margin-right: 14mm;
        @top-center   { content: element(header); }
        @bottom-left  { content: element(footer); } 
    }

    /* 3. ASSIGN THE BODY CONTENT TO THE NAMED PAGE */
    div.document-body {
        page: standard-content; 
    }

    /* Front cover container */
    div.cover-page {
        page-break-after: always;
        width: 210mm;
        height: 297mm;
        margin: 0mm;
    }

    body { font-family: Arial, sans-serif; font-size: 10px; color: #000; line-height: 1.5; padding: 0; margin: 0; }

    /* ── Running header / footer ── */
    .pdf-header { position: running(header); width: 100%; }
    .pdf-header img { width: 100%; height: auto; }
    
    .pdf-footer { position: running(footer); width: 182mm; }
    .pdf-footer img { width: 182mm; height: auto; display: block; margin: 0; padding: 0; }

    /* ── Letter meta row ── */
    .meta-table { width: 100%; border-collapse: collapse; margin-bottom: 8px; }
    .meta-table td { padding: 1px 3px; vertical-align: top; font-size: 10px; }

    /* ── Section headings ── */
    .section-heading { font-weight: bold; text-decoration: underline; font-size: 11px; margin: 14px 0 6px 0; }

    /* ── Main product table ── */
    .product-table { width: 100%; border-collapse: collapse; margin-bottom: 16px; }
    .product-table .table-title-row td { background-color: #fff; text-align: center; font-weight: bold; font-size: 11px; border: 1px solid #000; padding: 6px; letter-spacing: 1px; }
    .product-table th { background-color: #92D050; border: 1px solid #000; padding: 5px 4px; text-align: center; font-size: 9.5px; font-weight: bold; }
    .product-table td { border: 1px solid #000; padding: 5px 4px; text-align: center; vertical-align: middle; font-size: 10px; }
    .product-table td.left { text-align: left; }

    /* ── Supply Technical Particulars ── */
    .supply-section { margin: 16px 0; font-size: 10px; }
    .supply-section p { margin: 3px 0; }
    .bullet-list { margin: 4px 0 4px 16px; }
    .bullet-list li { margin-bottom: 3px; }

    /* ── TAndC ── */
    .tc-section { margin-top: 16px; font-size: 9.5px; line-height: 1.55; }
    .tc-section ol > li { margin-bottom: 8px; }

    /* ── Closing ── */
    .closing { margin-top: 20px; font-size: 10px; line-height: 1.7; }
     .signature-section {
                margin-top: 30px;
            }
    .avoid-break {
                page-break-inside: avoid;
            }
</style>
</head>
<body>
<div class="cover-page">
        <img src="{!$Resource.SolarCover}" style="width: 210mm; height: 297mm; display: block; margin: 0; padding: 0;" />
    </div>

    <div class="pdf-header">
        <img src="{!$Resource.UtkarshHeader}" style="width: 500px; height: auto;" />
    </div>
    

<!-- ══════════════════════════════════════════════════
     LETTER HEADER
     ══════════════════════════════════════════════════ -->
<div class="document-body">
<table class="meta-table">
    <tr>
        <td style="width: 1%; white-space: nowrap;"><b>Ref:</b>-</td>
        <td style="width: 55%;">{!quoteRecord.Quote_Reference__c}</td>
        
        <td style="width: 1%; white-space: nowrap;"><b>Date:</b>-</td>
