<apex:page standardController="Quote" extensions="QuoteExportController"
           renderAs="pdf" applyBodyTag="false" showHeader="false" standardStylesheets="false">
    <head>
        <style type="text/css" media="print">
            /* Master Page Layout - Handles all 16+ Pages */
            @page {
                size: A4;
                margin: 0mm;
            }

            @page standard-content {
                size: A4;
                margin-top: 130px;
                margin-right: 15mm;
                margin-bottom: 90px;
                margin-left: 15mm;
                @top-center { content: element(header); }
                @bottom-center { content: element(footer); }
            }

            div.document-body {
                page: standard-content;
                width: 100%;
                max-width: 180mm;
            }

            /* Full-bleed cover pages - no margins, no running header/footer */
            @page cover {
                size: A4;
                margin: 0mm;
                padding: 0mm;
                @top-center { content: none; }
                @bottom-center { content: none; }
            }

            /* FIX: Strict isolation for front and back covers.
               overflow: hidden is a backstop so a cover image can never spill
               onto a second physical page even if its intrinsic size is off. */
            /* Apply this to both front and back cover classes */
           /* FIX: Let the 'page' property handle the break natively. 
               Removing page-break-before/after prevents ghost pages. */
            .cover-page-front {
                page: cover;
                width: 210mm;
                height: 296mm; 
                margin: 0;
                padding: 0;
                line-height: 0 !important;
                font-size: 0 !important;
                overflow: hidden;
            }

            .cover-page-back {
                page: cover;
                width: 210mm;
                height: 296mm; 
                margin: 0;
                padding: 0;
                line-height: 0 !important;
                font-size: 0 !important;
                overflow: hidden;
            }

            /* Utility classes to kill running headers/footers on demand */
            .clear-header { position: running(header); height: 0; }
            .clear-footer { position: running(footer); height: 0; }
            /* NOTE: cover image sizing is intentionally set INLINE on each
               image tag (style="width:210mm; height:297mm; ...") rather than
               through this class selector. Keep any future cover-image sizing 
               inline, not here. */

            .pdf-header { position: running(header); width: 100%; }

            .pdf-footer { position: running(footer); width: 180mm; }

            /* Global Typography */
            body {
                font-family: sans-serif;
                font-size: 11.5px;
                color: #333;
                line-height: 1.5;
                margin: 0;
                padding: 0;
            }
            h1, h2, h3 { color: #0176d3; margin-bottom: 8px; }
            h3 { font-size: 13px; background-color: #f3f3f3; padding: 6px; border-left: 4px solid #0176d3; margin-top: 20px;}

            /* Repeating Header (Appears on every page automatically) */
            div.header {
                position: running(header);
                padding-top: 15px;
                width: 180mm;
            }
            .header-title { color: #FFFFFF; font-size: 22px; font-weight: bold; margin: 0; }
            .header-sub { font-size: 10px; color: #FFFFFF; }

            /* Repeating Footer - the actual running(footer) element used by
               this document is div.pdf-footer above. */
            .pagenumber:before { content: counter(page); }
            .pagecount:before { content: counter(pages); }

            /* Table Styling */
            table {
                width: 100%;
                max-width: 180mm;
                border-collapse: collapse;
                margin-bottom: 15px;
                page-break-inside: avoid;
                table-layout: fixed;
                word-wrap: break-word;
            }
            th { background-color: #0176d3; color: white; padding: 6px; border: 1px solid #ccc; font-size: 11px; text-align: left;}
            td { padding: 6px; border: 1px solid #ccc; font-size: 11px; vertical-align: top;}
            .no-border-table td { border: none; padding: 2px; }

            /* Utilities */
            .text-right { text-align: right; }
            .bold { font-weight: bold; }
            .page-break { page-break-before: always; }
            .legal-clause { margin-bottom: 10px; text-align: justify; }
            table.qrf-table { page-break-inside: auto !important; margin-top: 6px; margin-bottom: 14px; }
            .qrf-table th { background-color: #f0f0f0; color: #222; font-weight: bold; border: 1px solid #ccc; padding: 4px; }
            .qrf-table td { border: 1px solid #ccc; padding: 3px 4px; font-size: 9.5px; }
            .qrf-table tr { page-break-inside: avoid; }

            /* PEB Engineering Specification Document Styles (100% Fidelity) */
            .peb-spec-chapter {
                font-size: 11.5px !important;
                font-weight: bold !important;
                color: #000000 !important;
                margin-top: 14px !important;
                margin-bottom: 5px !important;
                background: none !important;
                border: none !important;
                padding: 0 !important;
                page-break-after: avoid !important;
                break-after: avoid !important;
            }
            .peb-spec-subheading {
                font-size: 10.5px !important;
                font-weight: bold !important;
                color: #000000 !important;
                margin-top: 10px !important;
                margin-bottom: 4px !important;
                background: none !important;
                border: none !important;
                padding: 0 !important;
                page-break-after: avoid !important;
                break-after: avoid !important;
            }
            .peb-spec-subtitle {
                font-size: 9.5px !important;
                color: #555555 !important;
                margin-top: 2px !important;
                margin-bottom: 4px !important;
                font-style: normal !important;
                page-break-after: avoid !important;
                break-after: avoid !important;
            }
            .peb-spec-text {
                font-size: 9.5px !important;
                color: #333333 !important;
                margin-top: 2px !important;
                margin-bottom: 3px !important;
                line-height: 1.35 !important;
            }
            table.peb-spec-table {
                width: 100%;
                max-width: 180mm;
                border-collapse: collapse;
                border-spacing: 0;
                empty-cells: show;
                margin-top: 4px;
                margin-bottom: 8px;
                page-break-inside: auto;
                table-layout: fixed;
            }
            table.peb-spec-table th,
            table.peb-spec-table td {
                border: 1px solid #000000;
                padding: 3px 5px;
                font-size: 9.5px;
                vertical-align: top;
                word-wrap: break-word;
                line-height: 1.25;
                /* Reetabrata (8th October 2026): the V2 building-description
                   parser keeps "a) ... / b) ..." items on their own lines
                   inside a cell as \n; pre-wrap prints those breaks. Older
                   quotes carry no \n in their cells, so they are unchanged. */
                white-space: pre-wrap;
            }
            table.peb-spec-table th {
                font-weight: bold !important;
                background-color: #f0f0f0 !important;
                color: #000000 !important;
            }
            table.peb-spec-table tr.subhead-row td {
                font-weight: bold !important;
                background-color: #f5f5f5 !important;
                color: #000000 !important;
            }
            table.peb-spec-table td {
                color: #333333;
                background-color: #ffffff;
            }
            table.peb-spec-table td b,
            table.peb-spec-table td strong {
                color: #000000 !important;
                font-weight: bold !important;
            }
            table.peb-spec-table tr {
                page-break-inside: avoid;
            }
        </style>
    </head>

    <body>
        <div class="cover-page-front">
            <img src="{!$Resource.PebFrontPage}" style="width: 210mm; height: 297mm; display: block; margin: 0; padding: 0; border: none;" />
        </div>

        <div class="document-body">
            <div class="header">
                <img src="{!$Resource.pebUtkarshlogo}" style="width: 100%; height: auto; display: block;" />
                <hr style="border: 0.5px solid #FFFFFF; margin: 0;"/>
            </div>

            <div class="pdf-footer">
                <img src="{!$Resource.UtkarshFooter}" style="width: 100%; height: auto; display: block; margin: 0; padding: 0;" />
            </div>

            <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px; margin-top: 10px;">
                <tr>
                    <td style="width: 50%; border: 1px solid #333; padding: 8px; vertical-align: top;">
                        Our Bank details:<br/><br/>
                        Bank: State Bank of India<br/>
                        Bank Address: Park Street, Kolkata-700016<br/>
                        Commercial Branch.<br/>
                        Company Name: Utkarsh India Limited<br/>
                        IFS Code: SBIN0007502<br/>
                        CC A/c. No.: 30546455614
                    </td>
                    <td style="width: 50%; border: 1px solid #333; padding: 8px; vertical-align: top;">
                        Contact Person:<br/><br/>
                        Name: Anindya Sinha<br/>
                        Phone No.: +91 9433034747.<br/>
                        E Mail: <a href="mailto:anindya@utkarshindia.in" style="color: blue;">anindya@utkarshindia.in</a>
                    </td>
                </tr>
            </table>

            <table class="no-border-table" style="margin-bottom: 20px;">
                <tr>
                    <td style="width: 60%;">
                        <b>Ref:</b> {!termsRef}<br/><br/>
                        <b>To:</b><br/><b>{!effectiveBuyerName}</b><apex:outputPanel layout="none" rendered="{!NOT(ISBLANK(effectiveProjectLocation))}"><br/>{!effectiveProjectLocation}</apex:outputPanel>
                    </td>
                    <td style="width: 40%;" class="text-right">
                        <b>Date:</b> {!termsDate}
                    </td>
                </tr>
            </table>
            <p class="bold">{!pebSubjectLine}</p>
            <p>Dear Sir/Madam,</p>
            <p>Your enquiry for supplying of the product as mentioned in the captioned subject has given us this opportunity to connect and introduce our company and the "Utkarsh" brand...</p>
            <p>We take pride to mention that you have approached one of the leading brands in the country engaged in the manufacturing of the product as described herein...</p>

            
            <!-- ═══ DYNAMIC BUILDING DESCRIPTION SECTIONS (FROM (A) DESIGN CRITERIA TO END) ═══ -->
            <apex:outputPanel rendered="{!docSections.size > 0}">
                <apex:repeat value="{!docSections}" var="sec">
                    <!-- Chapter Header -->
                    <apex:outputPanel layout="none" rendered="{!sec.isChapter}">
                        <p class="peb-spec-chapter"><b><apex:outputText value="{!sec.title}"/></b></p>
                        <apex:repeat value="{!sec.notes}" var="note">
                            <p class="peb-spec-text"><apex:outputText value="{!note}"/></p>
                        </apex:repeat>
                    </apex:outputPanel>

                    <!-- Section with Table -->
                    <apex:outputPanel layout="none" rendered="{!sec.isTable}">
                        <div style="{!IF(sec.isSmallTable, 'page-break-inside: avoid;', '')}">
                            <apex:outputPanel layout="none" rendered="{!NOT(ISBLANK(sec.title))}">
                                <p class="peb-spec-subheading"><b><apex:outputText value="{!sec.title}"/></b></p>
                            </apex:outputPanel>
                            <apex:outputPanel layout="none" rendered="{!sec.hasSubtitle}">
                                <p class="peb-spec-subtitle"><apex:outputText value="{!sec.subtitle}"/></p>
                            </apex:outputPanel>
                            <apex:outputText value="{!sec.tableHtml}" escape="false"/>
                            <apex:outputPanel layout="none" rendered="{!sec.hasNotes}">
                                <apex:repeat value="{!sec.notes}" var="note">
                                    <p class="peb-spec-text"><apex:outputText value="{!note}"/></p>
                                </apex:repeat>
                            </apex:outputPanel>
                        </div>
                    </apex:outputPanel>

                    <!-- Section with List (e.g. Technical Notes, Material Specifications) -->
                    <apex:outputPanel layout="none" rendered="{!sec.isList}">
                        <p class="peb-spec-subheading"><b><apex:outputText value="{!sec.title}"/></b></p>
                        <div style="margin-top: 2px; margin-bottom: 6px;">
                            <apex:repeat value="{!sec.listItems}" var="li">
                                <p class="peb-spec-text" style="padding-left: 8px; margin: 2px 0;"><apex:outputText value="{!li}"/></p>
                            </apex:repeat>
                        </div>
                    </apex:outputPanel>
                </apex:repeat>
            </apex:outputPanel>

            <!-- ═══ FALLBACK: QRF TABULAR FORMAT (IF docSections IS EMPTY) ═══ -->
            <apex:outputPanel rendered="{!docSections.size == 0 && paramTableRows.size > 0}">
                <table class="qrf-table" style="font-size: 10px; border-collapse: collapse; width: 100%; margin-top: 6px; margin-bottom: 14px; page-break-inside: auto;">
                    <thead>
                        <tr>
                            <th style="width: 5%; border: 1px solid #ccc; padding: 4px; text-align: center; background: #f0f0f0;">Sl. No.</th>
                            <th style="width: 28%; border: 1px solid #ccc; padding: 4px; background: #f0f0f0;">Parameter</th>
                            <th style="width: 9%; border: 1px solid #ccc; padding: 4px; text-align: center; background: #f0f0f0;">Unit / Type</th>
                            <th style="width: 30%; border: 1px solid #ccc; padding: 4px; background: #f0f0f0;">Value / Description</th>
                            <th style="width: 10%; border: 1px solid #ccc; padding: 4px; text-align: center; background: #f0f0f0;">Data from</th>
                            <th style="border: 1px solid #ccc; padding: 4px; background: #f0f0f0;">Remark</th>
                        </tr>
                    </thead>
                    <tbody>
                        <apex:repeat value="{!paramTableRows}" var="row">
                            <!-- Section header row (A., B., C., D.) -->
                            <apex:outputPanel layout="none" rendered="{!row.isHeader}">
                                <tr>
                                    <td colspan="6" style="border: 1px solid #ccc; padding: 4px 6px; font-weight: bold; background: #e8e8e8;">
                                        <apex:outputText value="{!row.slNo}"/>&nbsp;<apex:outputText value="{!row.parameter}"/>
                                    </td>
                                </tr>
                            </apex:outputPanel>
                            <!-- Data row -->
                            <apex:outputPanel layout="none" rendered="{!!row.isHeader}">
                                <tr>
                                    <td style="border: 1px solid #ccc; padding: 3px 4px; text-align: center; vertical-align: top;">{!row.slNo}</td>
                                    <td style="border: 1px solid #ccc; padding: 3px 4px; vertical-align: top;">{!row.parameter}</td>
                                    <td style="border: 1px solid #ccc; padding: 3px 4px; text-align: center; vertical-align: top;">{!row.unit}</td>
                                    <td style="border: 1px solid #ccc; padding: 3px 4px; vertical-align: top;">{!row.value}</td>
                                    <td style="border: 1px solid #ccc; padding: 3px 4px; text-align: center; vertical-align: top;">{!row.dataFrom}</td>
                                    <td style="border: 1px solid #ccc; padding: 3px 4px; vertical-align: top;">{!row.remark}</td>
                                </tr>
                            </apex:outputPanel>
                        </apex:repeat>
                    </tbody>
                </table>
            </apex:outputPanel>

            <div class="page-break"></div>
            <b style="font-size: 13px;">E. SUPPLY PRICE:-</b>

            <table>
                <tr>
                    <th style="width: 50%; text-align: center;">Description</th>
                    <th style="width: 50%; text-align: center;">Price (In INR)</th>
                </tr>
                <tr>
                    <td style="text-align: center; font-weight: bold;">Supply Price (Basic)</td>
                    <td style="text-align: center; font-weight: bold;"><apex:outputText value="{!supplyPriceBasic}"/>/-</td>
                </tr>
                <tr>
                    <td style="text-align: center; font-weight: bold;">GST @ 18%</td>
                    <td style="text-align: center; font-weight: bold;"><apex:outputText value="{!supplyPriceGst}"/>/-</td>
                </tr>
                <tr>
                    <td style="text-align: center; font-weight: bold;">Total Supply Price with GST</td>
                    <td style="text-align: center; font-weight: bold;"><apex:outputText value="{!supplyPriceWithGst}"/>/-</td>
                </tr>
            </table>

            <p style="font-weight: bold; margin-bottom: 5px;">
                Note: - There will be a separate Erection Order, which should be placed directly by the Buyer on our Authorized Builder.
            </p>
            <!-- <p style="font-weight: bold; margin-bottom: 15px;">
                Erection Price: Rs.0/- + GST@18% Extra.
            </p> -->

            <!-- <ul style="margin-top: 0; font-weight: bold; list-style-type: none; padding-left: 15px; margin-bottom: 20px;">
                <li>&#10148; Our tentative weight is <apex:outputText value=" {!tentativeWeightMt}"/> MT Steel and sheet. Quantities are subject to +/- 5 % at actual supply.</li>
            </ul> -->

            <table class="no-border-table">
                <tr>
                    <td style="width: 5%; font-weight: bold; vertical-align: top;">E.1</td>
                    <td style="width: 95%;">
                        <b style="font-size: 12px;">IMPORTANT TERMS &amp; CONDITIONS</b>
                        <table class="no-border-table" style="margin-top: 5px;">
                            <tr><td style="width: 3%; vertical-align: top;">1.</td><td>The Supply Price quoted above is inclusive of freight to Buyer's site from Utkarsh's plant.</td></tr>
                            <tr><td style="vertical-align: top;">2.</td><td>GST @ 18% extra will be applicable on supply and erection.</td></tr>
                            <tr><td style="vertical-align: top;">3.</td><td>Defect Liability Period will be 1 year from date of last dispatch document.</td></tr>
                            <tr><td style="vertical-align: top;">4.</td><td>TCS u/s 206 (1H) @ 0.10% will be charged extra, if applicable.</td></tr>
                        </table>

                        <ul style="font-weight: bold; margin-top: 10px; margin-bottom: 10px;">
                            <li>Pedestal top surface finish has to be non-shrink grout by the Buyer before start of Sheeting Work.</li>
                        </ul>

                        <p style="margin-bottom: 20px; line-height: 1.5; text-align: justify;">
                            "All data, information, drawings, specifications or any other documents received by either party from the other party shall be treated as confidential and the proprietary information of the other party and both parties shall not disclose such information in any manner than strictly required for the performance of this agreement and shall maintain strict confidentiality for the same. However, <b>Utkarsh</b> may use Customer's name &amp; testimonials as a reference in their customer list."
                        </p>
                    </td>
                </tr>
                <tr>
                    <td style="font-weight: bold; vertical-align: top;">E.2</td>
                    <td style="text-align: justify;">
                        <b>Rates and Taxes:</b> It is assumed that Octroi and Entry Tax are not applicable, if applicable the same shall have to be borne by the Buyer as per actual. The rates quoted are exclusive of <b>Goods &amp; Service Taxes and/or Excise Duty</b> and therefore the Goods &amp; Service Taxes shall be chargeable extra @18% on the total order value, as also excise duty shall be chargeable extra as at actual. Any changes in the statutory provisions for imposing of rates and taxes made applicable with immediate effect shall be implemented as per the implication of such statutory provisions.
                    </td>
                </tr>
                <tr>
                    <td style="font-weight: bold; vertical-align: top; padding-top: 15px;">E.3</td>
                    <td style="padding-top: 15px;">
                        <b>Exclusions:</b> The supply price and/or the quoted price does not include the items/components which are not included in the scope of the supply.<br/><br/>
                        <!-- <table class="no-border-table">
                            <tr><td style="width: 4%; vertical-align: top;">(a)</td><td>Any kind of roof accessories except mentioned herein;</td></tr>
                            <tr><td style="vertical-align: top;">(b)</td><td>Cable Tray, Ventilation duct, Pipe Support Structure;</td></tr>
                            <tr><td style="vertical-align: top;">(c)</td><td>Any support structure for additional load considered;</td></tr>
                            <tr><td style="vertical-align: top;">(d)</td><td>Roof Extractors, Roof Fans, vents, pipe flashing;</td></tr>
                            <tr><td style="vertical-align: top;">(e)</td><td>Wall vents, fans, overhead doors;</td></tr>
                            <tr><td style="vertical-align: top;">(f)</td><td>Civil, mechanical and electrical design and materials;</td></tr>
                            <tr><td style="vertical-align: top;">(g)</td><td>Miscellaneous steel except as specified herein;</td></tr>
                            <tr><td style="vertical-align: top;">(h)</td><td>Concrete embedded plates, expansion bolts or weld plate of any kind;</td></tr>
                            <tr><td style="vertical-align: top;">(i)</td><td>Construction temporary bracing;</td></tr>
                            <tr><td style="vertical-align: top;">(j)</td><td>Steel supports/bracing to accept collateral roof loads, except as referenced herein;</td></tr>
                            <tr><td style="vertical-align: top;">(k)</td><td>Architectural services of any kind;</td></tr>
                            <tr><td style="vertical-align: top;">(l)</td><td>All kinds of civil works;</td></tr>
                            <tr><td style="vertical-align: top;">(m)</td><td>Doors, windows and any kind of window framing;</td></tr>
                            <tr><td style="vertical-align: top;">(n)</td><td>Any other items not included in the building specifications included earlier;</td></tr>
                            <tr><td style="vertical-align: top;">(o)</td><td>Any kind of internal partitions except those mentioned herein;</td></tr>
                            <tr><td style="vertical-align: top;">(p)</td><td>Insulation.</td></tr>
                            <tr><td style="vertical-align: top;">(q)</td><td>Any local issue arising at site should be in the scope of the Buyer.</td></tr>
                        </table> -->
                    </td>
                </tr>

            <tr>
                    <td style="font-weight: bold; vertical-align: top; padding-top: 15px;">E.4</td>
                    <td style="text-align: justify; padding-top: 15px;">
                        <b>Third Party Sourcing:</b> The Supplier reserves the right to manufacture whole or part of the deliverables in the factories owned by its channel partners under the Supplier's quality and production control environment. Further various accessories will be purchased by the Supplier from its approved vendors as per the requirement of the project.
                    </td>
                </tr>

                <tr>
                    <td style="font-weight: bold; vertical-align: top; padding-top: 15px;">E.5</td>
                    <td style="text-align: justify; padding-top: 15px;">
                        <b>Payment Terms:</b> Prior to the Supplier's acceptance of the Buyer's supply order, the terms of payment shall have to be mutually agreed and accepted in writing between the Parties hereto and the disbursement of payment can be made as per the following options:
                            <p>

                        </p>
                        <!-- <span style="text-decoration: underline; font-weight: bold;">Option - I</span><br/> -->
                        <table class="no-border-table">
                            <tr><td style="width: 4%; vertical-align: top;">(a)</td><td>The Buyer shall be liable to remit a sum equivalent to 30% of the total supply order value unto and in favour of the Supplier together with the LOI and/or the supply order;</td></tr>
                            <tr><td style="vertical-align: top;">(b)</td><td>The Buyer shall be liable to remit a sum equivalent to the next 30% value of the total supply order value in favour of the Supplier within <b>seven</b> days from the date of approval of the GA drawings;</td></tr>
                            <tr><td style="vertical-align: top;">(c)</td><td>The Buyer shall be liable to remit a sum equivalent to the remaining 40% of the total value of the supply order unto and in favour of the Supplier at least <b>ten</b> days prior to effecting dispatch of the materials.</td></tr>
                        </table>
                        <br/>

                        <!-- <span style="text-decoration: underline; font-weight: bold;">Option - II</span><br/>
                        <table class="no-border-table">
                            <tr><td style="width: 4%; vertical-align: top;">(a)</td><td>The Buyer shall be liable to remit a sum equivalent to 30% of the total supply order value unto and in favour of the Supplier together with the LOI and/or the supply order;</td></tr>
                            <tr><td style="vertical-align: top;">(b)</td><td>The Buyer shall be liable to remit a sum equivalent to the remaining 70% of the total value of the supply order unto and in favour of the Supplier against irrevocable sight LC (Letter of Credit) which shall have to be opened within seven days from the date of approval of the GA drawings.</td></tr>
                        </table> -->
                    </td>
                </tr>

                <!-- Deepanjan (31st July 2026): this clause used to be a SECOND E.5.
                    It now renders only when the estimate carries an erection cost,
                    and takes its number from the controller so the sequence never
                    duplicates or skips. -->
                <apex:outputPanel layout="none" rendered="{!showErectionTerms}">
                <tr>
                    <td style="font-weight: bold; vertical-align: top; padding-top: 15px;">{!ptErectionNo}</td>
                    <td style="text-align: justify; padding-top: 15px;">
                        <b>Erection Payment Terms:</b> Prior to the Supplier's acceptance of the Buyer's supply order, the terms of payment for erection of the Pre-Engineered Building shall have to be mutually agreed and accepted in writing between the Parties hereto and the disbursement of payment shall be made in the following manner:
                        <p>

                        </p>
                        <table class="no-border-table">
                            <tr><td style="width: 4%; vertical-align: top;">(a)</td><td>The Buyer shall be liable to remit a sum equivalent to 20% of the total erection contract value unto and in favour of the erection contractor as and by way of advance payment before mobilization;</td></tr>
                            <tr><td style="vertical-align: top;">(b)</td><td>The Buyer shall be liable to remit a sum equivalent to next 50% of the total erection contract value unto and in favour of the erection contractor on completion of erection of the structure;</td></tr>
