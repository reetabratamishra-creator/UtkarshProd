      xmlns="http://www.w3.org/TR/REC-html40">
    
    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
        <style type="text/css">
            /* Global A4 Size Definition */
            @page {
                size: 210mm 297mm;
                margin: 0mm;
            }

            /* Word-Specific Page Layout Definitions and Margins */
            @page CoverPage {
                size: 210mm 297mm;
                margin: 0mm;
                mso-header-margin: 0mm;
                mso-footer-margin: 0mm;
            }
            
            @page StandardContent {
                size: 210mm 297mm;
                /* 20mm top/bottom margins, 10mm left/right margins */
                margin: 30mm 10mm 30mm 10mm; 
                mso-header: h1;
                mso-footer: f1;
                /* Provide a small margin so Word has space to render repeating headers/footers */
                mso-header-margin: 0mm;
                mso-footer-margin: 5mm;
            }

            @page LastPage {
                size: 210mm 297mm;
                margin: 0mm;
                mso-header-margin: 0mm;
                mso-footer-margin: 0mm;
                mso-header: h-blank; /* Forces Word to stop the running header */
                mso-footer: f-blank; /* Forces Word to stop the running footer */            
            }
            
            /* Class-to-Page Layout Mappings */
            div.page-cover {
                page: CoverPage;
                width: 210mm;
                height: 297mm;
                margin: 0mm;
            }
            
            div.document-body-inner {
                page: StandardContent;
            }

            /* Wrapper to apply padding strictly to content, not header/footer */
            .content-wrapper {
                padding: 2mm 18mm 2mm 18mm; /* Top, Right, Bottom, Left */
            }

            div.last-page {
                page: LastPage;
                width: 210mm;
                height: 297mm;
                margin: 0mm;
            }
            
            /* Global Typography Defaults */
            html, body {
                font-family: 'Arial', 'Helvetica', sans-serif;
                font-size: 10pt;
                line-height: 1.5;
                color: #222;
            }
            
            /* Page Break Controls for Word Content Flow */
            .page-break {
                page-break-before: always;
            }
            
            .avoid-break {
                page-break-inside: avoid;
            }
            
            /* Footer Layout Properties */
            .footer-inner {
                margin-bottom: 5mm;
                margin-top: 5mm;
                font-size: 7pt;
                color: black;
                line-height: 1.4;
                width: 100%;
            }
            
            .factory-details {
                margin-bottom: 3px;
            }
            
            .social-row {
                margin-top: 4px;
                font-size: 7.5pt;
            }
            
            /* Word Field Code Styles for Page Numbering */
            span.mso-page-number {
                mso-field-code: "PAGE";
            }
            span.mso-total-pages {
                mso-field-code: "NUMPAGES";
            }
            
            /* Data Tables Layout and Borders */
            .meta-table {
                width: 100%;
                margin-top: 20px;
                margin-bottom: 20px;
                border-collapse: collapse;
            }
            
            .meta-table td {
                vertical-align: top;
            }
            
            .subject-line {
                font-weight: bold;
                margin-top: 15px;
                margin-bottom: 15px;
                text-align: justify;
            }
            
            .content-table {
                width: 100%;
                border-collapse: collapse;
                margin-top: 5px;
                margin-bottom: 5px;
                font-size: 9pt;
            }
            
            .content-table th {
                background-color: #f4f4f4;
                border: 1px solid #111;
                font-weight: bold;
                padding: 6px;
                text-align: center;
            }
            
            .content-table td {
                border: 1px solid #111;
                padding: 6px;
                vertical-align: top;
            }
            
            .text-right { text-align: right; }
            .text-left { text-align: left; }
            .text-center { text-align: center; }
            
            .total-row {
                font-weight: bold;
                background-color: #f9f9f9;
            }
            
            .terms-heading {
                font-size: 11pt;
                font-weight: bold;
                margin-top: 25px;
                margin-bottom: 10px;
                border-bottom: 1px solid #000;
                padding-bottom: 2px;
            }
            
            .term-item {
                margin-bottom: 12px;
                text-align: justify;
            }
            
            .term-title {
                font-weight: bold;
            }
            
            .signature-section {
                margin-top: 30px;
            }
        </style>
    </head>    
