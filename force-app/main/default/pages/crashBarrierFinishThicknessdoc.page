<apex:page standardController="Quote"
           extensions="QuoteExportController"
           contentType="application/msword#CrashBarrierFinishThickness-{!referenceNum}.doc"
           applyBodyTag="false"
           applyHtmlTag="false"
           showHeader="false"
           sidebar="false"
           standardStylesheets="false">
<html xmlns:o="urn:schemas-microsoft-com:office:office"
      xmlns:w="urn:schemas-microsoft-com:office:word"
      xmlns="http://www.w3.org/TR/REC-html40">
    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
        <style type="text/css">
            /* ── Word page layout — header/footer via mso-header/mso-footer ── */
            @page WordSection1 {
                size: A4;
                margin-top: 40mm;
                margin-bottom: 35mm;
                margin-left: 15mm;
                margin-right: 15mm;
                mso-header-margin: 8mm;
                mso-footer-margin: 8mm;
                mso-header: h1;
                mso-footer: f1;
            }
            div.WordSection1 { page: WordSection1; }

            body {
                font-family: sans-serif;
                font-size: 11px;
                color: #333;
            }

            /* ── Specifications Table Styling ── */
            .spec-table {
                width: 100%;
                border-collapse: collapse;
                border: 1px solid #000;
                margin-top: 5px;
                margin-bottom: 20px;
            }
            .spec-table th, .spec-table td {
                border: 1px solid #000;
                padding: 6px;
                text-align: center;
            }
            .spec-table th {
                background-color: #f2f2f2;
                font-weight: bold;
                font-size: 10px;
            }
            .spec-table td {
                font-size: 10px;
            }
            .table-title {
                font-weight: bold;
                font-size: 11px;
                margin-top: 15px;
                text-align: left;
            }

        </style>
    </head>
    <body>
        <div class="WordSection1">

        
        <apex:repeat value="{!lineItems}" var="row">
            
            <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'CRASH TESTED') || CONTAINS(UPPER(row['name']), 'CONVENTIONAL') || CONTAINS(UPPER(row['name']), 'RAILWAY') || CONTAINS(UPPER(row['name']), 'NON-SPACER')}">
                
                <div class="table-title">{!row['name']}</div>
                
                <table border="1" cellspacing="0" cellpadding="4" style="width: 85%; border-collapse: collapse; font-family: sans-serif; font-size: 10px; table-layout: fixed; word-wrap: break-word;">
                    <thead>
                        <tr>
                            <th style="width: 33%;">THICKNESS NAME</th>
                            <th style="width: 33%;">BLACK THICKNESS</th>
                            <th style="width: 33%;">FINISHED THICKNESS</th>
                        </tr>
                    </thead>
                    <tbody>
                        
                        <tr>
                            <td style="font-weight: bold;">BEAM</td>
                            
                            <td>
                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'NATRAX')}">
                                    <apex:outputText value="{!IF(CONTAINS(UPPER(row['name']), 'THRIE'), jsonData['tb_natrax_beam_thickness'], jsonData['wb_natrax_beam_thickness'])}"/>
                                </apex:outputPanel>
                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'ALKA')}">
                                    <apex:outputText value="{!IF(CONTAINS(UPPER(row['name']), 'THRIE'), jsonData['tb_alka_beam_thickness'], jsonData['wb_alka_beam_thickness'])}"/>
                                </apex:outputPanel>
                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'TRANSPOLIS')}">
                                    <apex:outputText value="{!jsonData['wb_trans_beam_thickness']}"/>
                                </apex:outputPanel>
                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'RAILWAY')}">2</apex:outputPanel>
                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'NON-SPACER')}">
                                    <apex:outputText value="{!IF(CONTAINS(UPPER(row['name']), 'THRIE'), jsonData['ns_thrie_beam_section_beam_thickness_input'], jsonData['ns_w_beam_section_beam_thickness_input'])}"/>
                                </apex:outputPanel>
                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'CONVENTIONAL')}">
                                    <apex:outputText value="{!IF(CONTAINS(UPPER(row['name']), 'SSSB'), IF(CONTAINS(UPPER(row['name']), 'THRIE'), jsonData['Thrie_SSSB_beamThickness_input'], jsonData['w_SSSB_w_beam_beamThickness_input']), 
                                                              IF(CONTAINS(UPPER(row['name']), 'SSDB'), IF(CONTAINS(UPPER(row['name']), 'THRIE'), jsonData['Thrie_SSDB_beamThickness_input'], jsonData['w_SSDB_w_beam_beamThickness_input']),
                                                              IF(CONTAINS(UPPER(row['name']), 'DSSB'), IF(CONTAINS(UPPER(row['name']), 'THRIE'), jsonData['Thrie_DSSB_beamThickness_input'], jsonData['w_DSSB_w_beam_beamThickness_input']),
                                                              IF(CONTAINS(UPPER(row['name']), 'DSDB'), IF(CONTAINS(UPPER(row['name']), 'THRIE'), jsonData['Thrie_DSDB_beamThickness_input'], jsonData['w_DSDB_w_beam_beamThickness_input']), ''))))}"/>
                                </apex:outputPanel>
                            </td>

                            <td>
                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'NATRAX') && NOT(CONTAINS(UPPER(row['name']), 'THRIE'))}">
                                    <apex:outputText value="{0, number, 0.00}"><apex:param value="{!VALUE(jsonData['wb_natrax_beam_thickness']) + ((IF(CONTAINS(jsonData['wb_natrax_zinc_coating'], 'Regular'), 40, IF(CONTAINS(jsonData['wb_natrax_zinc_coating'], 'Average'), 65, IF(CONTAINS(jsonData['wb_natrax_zinc_coating'], 'Minimum'), 77, 0))) / 1000) * 2)}" /></apex:outputText>
                                </apex:outputPanel>
                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'NATRAX') && CONTAINS(UPPER(row['name']), 'THRIE')}">
                                    <apex:outputText value="{0, number, 0.00}"><apex:param value="{!VALUE(jsonData['tb_natrax_beam_thickness']) + ((IF(CONTAINS(jsonData['tb_natrax_zinc_coating'], 'Regular'), 40, IF(CONTAINS(jsonData['tb_natrax_zinc_coating'], 'Average'), 65, IF(CONTAINS(jsonData['tb_natrax_zinc_coating'], 'Minimum'), 77, 0))) / 1000) * 2)}" /></apex:outputText>
                                </apex:outputPanel>

                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'ALKA') && NOT(CONTAINS(UPPER(row['name']), 'THRIE'))}">
                                    <apex:outputText value="{0, number, 0.00}"><apex:param value="{!VALUE(jsonData['wb_alka_beam_thickness']) + ((IF(CONTAINS(jsonData['wb_alka_zinc_coating'], 'Regular'), 40, IF(CONTAINS(jsonData['wb_alka_zinc_coating'], 'Average'), 65, IF(CONTAINS(jsonData['wb_alka_zinc_coating'], 'Minimum'), 77, 0))) / 1000) * 2)}" /></apex:outputText>
                                </apex:outputPanel>
                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'ALKA') && CONTAINS(UPPER(row['name']), 'THRIE')}">
                                    <apex:outputText value="{0, number, 0.00}"><apex:param value="{!VALUE(jsonData['tb_alka_beam_thickness']) + ((IF(CONTAINS(jsonData['tb_alka_zinc_coating'], 'Regular'), 40, IF(CONTAINS(jsonData['tb_alka_zinc_coating'], 'Average'), 65, IF(CONTAINS(jsonData['tb_alka_zinc_coating'], 'Minimum'), 77, 0))) / 1000) * 2)}" /></apex:outputText>
                                </apex:outputPanel>

                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'TRANSPOLIS')}">
                                    <apex:outputText value="{0, number, 0.00}"><apex:param value="{!VALUE(jsonData['wb_trans_beam_thickness']) + ((IF(CONTAINS(jsonData['wb_trans_zinc_coating'], 'Regular'), 40, IF(CONTAINS(jsonData['wb_trans_zinc_coating'], 'Average'), 65, IF(CONTAINS(jsonData['wb_trans_zinc_coating'], 'Minimum'), 77, 0))) / 1000) * 2)}" /></apex:outputText>
                                </apex:outputPanel>

                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'RAILWAY')}">2.15</apex:outputPanel>

                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'NON-SPACER') && NOT(CONTAINS(UPPER(row['name']), 'THRIE'))}">
                                    <apex:outputText value="{0, number, 0.00}"><apex:param value="{!VALUE(jsonData['ns_w_beam_section_beam_thickness_input']) + ((IF(CONTAINS(jsonData['ns_w_beam_section_zinc_coating_input'], 'Regular'), 40, IF(CONTAINS(jsonData['ns_w_beam_section_zinc_coating_input'], 'Average'), 65, IF(CONTAINS(jsonData['ns_w_beam_section_zinc_coating_input'], 'Minimum'), 77, 0))) / 1000) * 2)}" /></apex:outputText>
                                </apex:outputPanel>
                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'NON-SPACER') && CONTAINS(UPPER(row['name']), 'THRIE')}">
                                    <apex:outputText value="{0, number, 0.00}"><apex:param value="{!VALUE(jsonData['ns_thrie_beam_section_beam_thickness_input']) + ((IF(CONTAINS(jsonData['ns_thrie_beam_section_zinc_coating_input'], 'Regular'), 40, IF(CONTAINS(jsonData['ns_thrie_beam_section_zinc_coating_input'], 'Average'), 65, IF(CONTAINS(jsonData['ns_thrie_beam_section_zinc_coating_input'], 'Minimum'), 77, 0))) / 1000) * 2)}" /></apex:outputText>
                                </apex:outputPanel>

                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'CONVENTIONAL') && CONTAINS(UPPER(row['name']), 'SSSB') && NOT(CONTAINS(UPPER(row['name']), 'THRIE'))}">
                                    <apex:outputText value="{0, number, 0.00}"><apex:param value="{!VALUE(jsonData['w_SSSB_w_beam_beamThickness_input']) + ((IF(CONTAINS(jsonData['w_SSSB_w_beam_zincCoating_input'], 'Regular'), 40, IF(CONTAINS(jsonData['w_SSSB_w_beam_zincCoating_input'], 'Average'), 65, IF(CONTAINS(jsonData['w_SSSB_w_beam_zincCoating_input'], 'Minimum'), 77, 0))) / 1000) * 2)}" /></apex:outputText>
                                </apex:outputPanel>
                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'CONVENTIONAL') && CONTAINS(UPPER(row['name']), 'SSDB') && NOT(CONTAINS(UPPER(row['name']), 'THRIE'))}">
                                    <apex:outputText value="{0, number, 0.00}"><apex:param value="{!VALUE(jsonData['w_SSDB_w_beam_beamThickness_input']) + ((IF(CONTAINS(jsonData['w_SSDB_w_beam_zincCoating_input'], 'Regular'), 40, IF(CONTAINS(jsonData['w_SSDB_w_beam_zincCoating_input'], 'Average'), 65, IF(CONTAINS(jsonData['w_SSDB_w_beam_zincCoating_input'], 'Minimum'), 77, 0))) / 1000) * 2)}" /></apex:outputText>
                                </apex:outputPanel>
                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'CONVENTIONAL') && CONTAINS(UPPER(row['name']), 'DSSB') && NOT(CONTAINS(UPPER(row['name']), 'THRIE'))}">
                                    <apex:outputText value="{0, number, 0.00}"><apex:param value="{!VALUE(jsonData['w_DSSB_w_beam_beamThickness_input']) + ((IF(CONTAINS(jsonData['w_DSSB_w_beam_zincCoating_input'], 'Regular'), 40, IF(CONTAINS(jsonData['w_DSSB_w_beam_zincCoating_input'], 'Average'), 65, IF(CONTAINS(jsonData['w_DSSB_w_beam_zincCoating_input'], 'Minimum'), 77, 0))) / 1000) * 2)}" /></apex:outputText>
                                </apex:outputPanel>
                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'CONVENTIONAL') && CONTAINS(UPPER(row['name']), 'DSDB') && NOT(CONTAINS(UPPER(row['name']), 'THRIE'))}">
                                    <apex:outputText value="{0, number, 0.00}"><apex:param value="{!VALUE(jsonData['w_DSDB_w_beam_beamThickness_input']) + ((IF(CONTAINS(jsonData['w_DSDB_w_beam_zincCoating_input'], 'Regular'), 40, IF(CONTAINS(jsonData['w_DSDB_w_beam_zincCoating_input'], 'Average'), 65, IF(CONTAINS(jsonData['w_DSDB_w_beam_zincCoating_input'], 'Minimum'), 77, 0))) / 1000) * 2)}" /></apex:outputText>
                                </apex:outputPanel>
                            </td>
                        </tr>
                        
                        <tr>
                            <td style="font-weight: bold;">POST</td>
                            
                            <td>
                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'NATRAX')}">
                                    <apex:outputText value="{!IF(CONTAINS(UPPER(row['name']), 'THRIE'), jsonData['tb_natrax_post_thickness'], jsonData['wb_natrax_post_thickness'])}"/>
                                </apex:outputPanel>
                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'ALKA')}">
                                    <apex:outputText value="{!IF(CONTAINS(UPPER(row['name']), 'THRIE'), jsonData['tb_alka_post_thickness'], jsonData['wb_alka_post_thickness'])}"/>
                                </apex:outputPanel>
                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'TRANSPOLIS')}">
                                    <apex:outputText value="{!jsonData['wb_trans_post_thickness']}"/>
                                </apex:outputPanel>
                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'RAILWAY')}">4</apex:outputPanel>
                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'NON-SPACER')}">
                                    <apex:outputText value="{!IF(CONTAINS(UPPER(row['name']), 'THRIE'), jsonData['ns_thrie_beam_section_post_thickness_input'], jsonData['ns_w_beam_section_post_thickness_input'])}"/>
                                </apex:outputPanel>
                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'CONVENTIONAL')}">
                                    <apex:outputText value="{!IF(CONTAINS(UPPER(row['name']), 'SSSB'), IF(CONTAINS(UPPER(row['name']), 'THRIE'), jsonData['Thrie_SSSB_postThickness_input'], jsonData['w_SSSB_w_beam_postThickness_input']), 
                                                              IF(CONTAINS(UPPER(row['name']), 'SSDB'), IF(CONTAINS(UPPER(row['name']), 'THRIE'), jsonData['Thrie_SSDB_postThickness_input'], jsonData['w_SSDB_w_beam_postThickness_input']),
                                                              IF(CONTAINS(UPPER(row['name']), 'DSSB'), IF(CONTAINS(UPPER(row['name']), 'THRIE'), jsonData['Thrie_DSSB_postThickness_input'], jsonData['w_DSSB_w_beam_postThickness_input']),
                                                              IF(CONTAINS(UPPER(row['name']), 'DSDB'), IF(CONTAINS(UPPER(row['name']), 'THRIE'), jsonData['Thrie_DSDB_postThickness_input'], jsonData['w_DSDB_w_beam_postThickness_input']), ''))))}"/>
                                </apex:outputPanel>
                            </td>

                            <td>
                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'NATRAX') && NOT(CONTAINS(UPPER(row['name']), 'THRIE'))}">
                                    <apex:outputText value="{0, number, 0.00}"><apex:param value="{!VALUE(jsonData['wb_natrax_post_thickness']) + ((IF(CONTAINS(jsonData['wb_natrax_zinc_coating'], 'Regular'), 40, IF(CONTAINS(jsonData['wb_natrax_zinc_coating'], 'Average'), 65, IF(CONTAINS(jsonData['wb_natrax_zinc_coating'], 'Minimum'), 77, 0))) / 1000) * 2)}" /></apex:outputText>
                                </apex:outputPanel>
                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'NATRAX') && CONTAINS(UPPER(row['name']), 'THRIE')}">
                                    <apex:outputText value="{0, number, 0.00}"><apex:param value="{!VALUE(jsonData['tb_natrax_post_thickness']) + ((IF(CONTAINS(jsonData['tb_natrax_zinc_coating'], 'Regular'), 40, IF(CONTAINS(jsonData['tb_natrax_zinc_coating'], 'Average'), 65, IF(CONTAINS(jsonData['tb_natrax_zinc_coating'], 'Minimum'), 77, 0))) / 1000) * 2)}" /></apex:outputText>
                                </apex:outputPanel>

                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'ALKA') && NOT(CONTAINS(UPPER(row['name']), 'THRIE'))}">
                                    <apex:outputText value="{0, number, 0.00}"><apex:param value="{!VALUE(jsonData['wb_alka_post_thickness']) + ((IF(CONTAINS(jsonData['wb_alka_zinc_coating'], 'Regular'), 40, IF(CONTAINS(jsonData['wb_alka_zinc_coating'], 'Average'), 65, IF(CONTAINS(jsonData['wb_alka_zinc_coating'], 'Minimum'), 77, 0))) / 1000) * 2)}" /></apex:outputText>
                                </apex:outputPanel>
                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'ALKA') && CONTAINS(UPPER(row['name']), 'THRIE')}">
                                    <apex:outputText value="{0, number, 0.00}"><apex:param value="{!VALUE(jsonData['tb_alka_post_thickness']) + ((IF(CONTAINS(jsonData['tb_alka_zinc_coating'], 'Regular'), 40, IF(CONTAINS(jsonData['tb_alka_zinc_coating'], 'Average'), 65, IF(CONTAINS(jsonData['tb_alka_zinc_coating'], 'Minimum'), 77, 0))) / 1000) * 2)}" /></apex:outputText>
                                </apex:outputPanel>

                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'TRANSPOLIS')}">
                                    <apex:outputText value="{0, number, 0.00}"><apex:param value="{!VALUE(jsonData['wb_trans_post_thickness']) + ((IF(CONTAINS(jsonData['wb_trans_zinc_coating'], 'Regular'), 40, IF(CONTAINS(jsonData['wb_trans_zinc_coating'], 'Average'), 65, IF(CONTAINS(jsonData['wb_trans_zinc_coating'], 'Minimum'), 77, 0))) / 1000) * 2)}" /></apex:outputText>
                                </apex:outputPanel>

                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'RAILWAY')}">4.15</apex:outputPanel>

                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'NON-SPACER') && NOT(CONTAINS(UPPER(row['name']), 'THRIE'))}">
                                    <apex:outputText value="{0, number, 0.00}"><apex:param value="{!VALUE(jsonData['ns_w_beam_section_post_thickness_input']) + ((IF(CONTAINS(jsonData['ns_w_beam_section_zinc_coating_input'], 'Regular'), 40, IF(CONTAINS(jsonData['ns_w_beam_section_zinc_coating_input'], 'Average'), 65, IF(CONTAINS(jsonData['ns_w_beam_section_zinc_coating_input'], 'Minimum'), 77, 0))) / 1000) * 2)}" /></apex:outputText>
                                </apex:outputPanel>
                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'NON-SPACER') && CONTAINS(UPPER(row['name']), 'THRIE')}">
                                    <apex:outputText value="{0, number, 0.00}"><apex:param value="{!VALUE(jsonData['ns_thrie_beam_section_post_thickness_input']) + ((IF(CONTAINS(jsonData['ns_thrie_beam_section_zinc_coating_input'], 'Regular'), 40, IF(CONTAINS(jsonData['ns_thrie_beam_section_zinc_coating_input'], 'Average'), 65, IF(CONTAINS(jsonData['ns_thrie_beam_section_zinc_coating_input'], 'Minimum'), 77, 0))) / 1000) * 2)}" /></apex:outputText>
                                </apex:outputPanel>

                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'CONVENTIONAL') && CONTAINS(UPPER(row['name']), 'SSSB') && NOT(CONTAINS(UPPER(row['name']), 'THRIE'))}">
                                    <apex:outputText value="{0, number, 0.00}"><apex:param value="{!VALUE(jsonData['w_SSSB_w_beam_postThickness_input']) + ((IF(CONTAINS(jsonData['w_SSSB_w_beam_zincCoating_input'], 'Regular'), 40, IF(CONTAINS(jsonData['w_SSSB_w_beam_zincCoating_input'], 'Average'), 65, IF(CONTAINS(jsonData['w_SSSB_w_beam_zincCoating_input'], 'Minimum'), 77, 0))) / 1000) * 2)}" /></apex:outputText>
                                </apex:outputPanel>
                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'CONVENTIONAL') && CONTAINS(UPPER(row['name']), 'SSDB') && NOT(CONTAINS(UPPER(row['name']), 'THRIE'))}">
                                    <apex:outputText value="{0, number, 0.00}"><apex:param value="{!VALUE(jsonData['w_SSDB_w_beam_postThickness_input']) + ((IF(CONTAINS(jsonData['w_SSDB_w_beam_zincCoating_input'], 'Regular'), 40, IF(CONTAINS(jsonData['w_SSDB_w_beam_zincCoating_input'], 'Average'), 65, IF(CONTAINS(jsonData['w_SSDB_w_beam_zincCoating_input'], 'Minimum'), 77, 0))) / 1000) * 2)}" /></apex:outputText>
                                </apex:outputPanel>
                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'CONVENTIONAL') && CONTAINS(UPPER(row['name']), 'DSSB') && NOT(CONTAINS(UPPER(row['name']), 'THRIE'))}">
                                    <apex:outputText value="{0, number, 0.00}"><apex:param value="{!VALUE(jsonData['w_DSSB_w_beam_postThickness_input']) + ((IF(CONTAINS(jsonData['w_DSSB_w_beam_zincCoating_input'], 'Regular'), 40, IF(CONTAINS(jsonData['w_DSSB_w_beam_zincCoating_input'], 'Average'), 65, IF(CONTAINS(jsonData['w_DSSB_w_beam_zincCoating_input'], 'Minimum'), 77, 0))) / 1000) * 2)}" /></apex:outputText>
                                </apex:outputPanel>
                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'CONVENTIONAL') && CONTAINS(UPPER(row['name']), 'DSDB') && NOT(CONTAINS(UPPER(row['name']), 'THRIE'))}">
                                    <apex:outputText value="{0, number, 0.00}"><apex:param value="{!VALUE(jsonData['w_DSDB_w_beam_postThickness_input']) + ((IF(CONTAINS(jsonData['w_DSDB_w_beam_zincCoating_input'], 'Regular'), 40, IF(CONTAINS(jsonData['w_DSDB_w_beam_zincCoating_input'], 'Average'), 65, IF(CONTAINS(jsonData['w_DSDB_w_beam_zincCoating_input'], 'Minimum'), 77, 0))) / 1000) * 2)}" /></apex:outputText>
                                </apex:outputPanel>
                            </td>
                        </tr>

                        <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'NATRAX') || CONTAINS(UPPER(row['name']), 'CONVENTIONAL')}">
                            <tr>
                                <td style="font-weight: bold;">SPACER</td>
                                
                                <td>
                                    <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'NATRAX')}">
                                        <apex:outputText value="{!IF(CONTAINS(UPPER(row['name']), 'THRIE'), jsonData['tb_natrax_spacer_thickness'], jsonData['wb_natrax_spacer_thickness'])}"/>
                                    </apex:outputPanel>
                                    
                                    <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'CONVENTIONAL')}">
                                        <apex:outputText value="{!IF(CONTAINS(UPPER(row['name']), 'SSSB'), IF(CONTAINS(UPPER(row['name']), 'THRIE'), jsonData['Thrie_SSSB_spacerThickness_input'], jsonData['w_SSSB_w_beam_spacerThickness_input']), 
                                                                  IF(CONTAINS(UPPER(row['name']), 'SSDB'), IF(CONTAINS(UPPER(row['name']), 'THRIE'), jsonData['Thrie_SSDB_spacerThickness_input'], jsonData['w_SSDB_w_beam_spacerThickness_input']),
