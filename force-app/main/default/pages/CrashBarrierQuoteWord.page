                            <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 10%; font-weight: bold;">HSN Code</th>
                            <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 10%; font-weight: bold;">UNIT</th>
                            <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 10%; font-weight: bold;">QTY</th>
                            <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 10%; font-weight: bold;">RATE/MTR</th>
