                            </td>
                            <td rowspan="5" style="border: 1px solid #000; padding: 4px; text-align: center; vertical-align: middle;">73089090</td>
                            <td rowspan="5" style="border: 1px solid #000; padding: 4px; text-align: center; vertical-align: middle;">MTR</td>
                            <td rowspan="5" style="border: 1px solid #000; padding: 4px; text-align: center; vertical-align: middle;">{!row['quantity']}</td>
