<apex:page standardController="Quote"
           extensions="QuoteExportController"
           contentType="application/msword#CrashBarrier-{!referenceNum}.doc"
           applyBodyTag="false"
           applyHtmlTag="false"
           showHeader="false"
           sidebar="false"
           standardStylesheets="false">
    <html xmlns:o="urn:schemas-microsoft-com:office:office"
      xmlns:w="urn:schemas-microsoft-com:office:word"
      xmlns="http://www.w3.org/TR/REC-html40">
        
    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
        <style type="text/css">

        /* ── Global A4 ── */
        @page {
            size: 210mm 297mm;
            margin: 0mm;
        }

        /* ── Content pages with repeating header/footer ── */
        @page StandardContent {
            size: 210mm 297mm;
            margin: 38mm 14mm 28mm 14mm;
            mso-header: h1;
            mso-footer: f1;
            mso-header-margin: 5mm;
            mso-footer-margin: 5mm;
        }
        div.document-body { page: StandardContent; }

        /* ── Page number spans ── */
        span.mso-page-number  { mso-field-code: "PAGE"; }
        span.mso-total-pages  { mso-field-code: "NUMPAGES"; }

        /* ── Base ── */
        html, body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 10pt;
            color: #222;
            line-height: 1.5;
        }

        .content-wrapper { padding: 0 4mm; }

        /* ── Page break ── */
        .page-break { page-break-before: always; }

        /* ── Letter meta ── */
        .meta-table { width: 100%; border-collapse: collapse; margin-bottom: 8pt; }
        .meta-table td { padding: 1pt 3pt; vertical-align: top; font-size: 10pt; }

        /* ── Product table ── */
        .product-table { width: 100%; border-collapse: collapse; margin-bottom: 14pt; }
        .product-table .title-row td {
            text-align: center;
            font-weight: bold;
            font-size: 11pt;
            border: 1pt solid #000;
            padding: 5pt;
            letter-spacing: 1px;
        }
        .product-table th {
            background-color: #92D050;
            border: 1pt solid #000;
            padding: 4pt;
            text-align: center;
            font-size: 9pt;
            font-weight: bold;
        }
        .product-table td {
            border: 1pt solid #000;
            padding: 4pt;
            text-align: center;
            vertical-align: middle;
            font-size: 10pt;
        }
        .product-table td.left { text-align: left; }
        .mat-name { font-weight: bold; }
        .mat-desc { font-size: 9pt; color: #333; }

        /* ── TandC ── */
        .tc-section { font-size: 9.5pt; line-height: 1.55; }
        .tc-section ol > li { margin-bottom: 7pt; }
        .tc-section ol > li > ol { margin-top: 4pt; }
        .tc-section ol > li > ul { margin-top: 4pt; }

        /* ── Footer inner ── */
        .footer-inner {
            font-size: 7pt;
            color: #000;
            line-height: 1.4;
            width: 100%;
        }

    </style>
    </head>
    <body>
         <div class="document-body">
			<div class="content-wrapper">
        
       

        <table style="width: 85%; font-size: 10px; font-weight: bold; margin-bottom: 25px;">
            <tr>
                <td style="text-align: left; text-decoration: underline;">REF: UIL/MBCB/{!quoteRecord.Name}</td>
                <td style="text-align: right; text-decoration: underline;">DATE: {!todayDate}</td>
            </tr>
        </table>
        <div style="margin-bottom: 20px;"><b>To,</b><br/>{!accountName}</div>
        <div style="margin-bottom: 20px;"><b>KIND ATTN: Mr/Ms. {!contactName}</b><br/><b>EMAIL ID: {!contactEmail}</b></div>
        <div style="margin-bottom: 20px;"><b>SUB: Our offer for 'Metal Beam Crash Barriers of "Utkarsh" Brand.</b></div>
        <div style="margin-bottom: 25px; line-height: 1.6;">
            Dear Madam / Sir<br/><br/>
            <span style="font-weight: bold; background-color: #FFFF00;">Please refer to your enquiry &amp; the discussion had with Mr/Ms. {!$User.FirstName} {!$User.LastName}</span><br/>
            Our Quotes for the Metal Beam Crash Barriers "Utkarsh" brand as enquired by you is as mentioned below along with our details terms and conditions.
        </div>

        <apex:variable var="rowNum" value="{!1}"/>

        <apex:repeat value="{!lineItems}" var="row">

            <apex:outputPanel rendered="{!CONTAINS(UPPER(row['name']), 'NATRAX')}">
