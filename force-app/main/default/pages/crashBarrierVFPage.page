<apex:page standardController="Quote" extensions="CrashBarrierQuoteController" renderAs="pdf" applyHtmlTag="false" showHeader="false" standardStylesheets="false">
    <html>
    <head>
        <style type="text/css">
            @page {
                size: A4;
                /* Create physical space at the top and bottom of every page for the header/footer */
                margin-top: 40mm;    
                margin-bottom: 35mm; /* Increased to 50mm so the footer doesn't chop your text */
                margin-left: 15mm;   /* Increased to 15mm for standard professional borders */
                margin-right: 15mm;
                /* This injects the running elements into the page margins */
                @top-center {
                    content: element(header);
                }
                @bottom-center {
                    content: element(footer);
                }
            }
	
			<apex:outputPanel layout="none" rendered="{!jsonData['MBCB_Type'] != 'Noise Barrier'}">
                @page :first {
                    margin: 0mm;
                    @top-center { content: normal; }
                    @bottom-center { content: normal; }
                }
            </apex:outputPanel>

            .cover-page {
                page-break-after: always; 
                line-height: 0; 
                font-size: 0;
                margin: 0;
                padding: 0;
                height: 290mm; /* 🛑 Restricts the container to slightly under A4 height */
                overflow: hidden; /* 🛑 Brutally chops off any microscopic decimal spillage */
            }
            
            body {
                font-family: sans-serif;
                font-size: 11px;
                color: #333;
                white-space: normal; /* Ensures text wraps normally */
            }
            
            /* ── Assign the header and footer to the running elements ── */
            .pdf-header {
                position: running(header);
            }
            
            .pdf-footer {
                position: running(footer);
                text-align: right;
                font-size: 8px;
                line-height: 1.3;
                color: #333;
            }
            /* 1. Prevents table rows from splitting in half */
            tr {
                page-break-inside: avoid;
            }

            /* 2. Prevents Terms  Conditions paragraphs from slicing horizontally */
            p {
                page-break-inside: avoid;
            }

            /* 3. Keeps headers attached to their following paragraphs */
            .keep-together {
                page-break-after: avoid;
            }
            
            * {
                box-sizing: border-box !important;
                word-wrap: break-word !important;
                overflow-wrap: break-word !important;
            }
            
            html, body {
                width: 100%;
                max-width: 100%;
                margin: 0;
                padding: 0;
            }
            .keepTogether {
                page-break-inside: avoid;
            }
            
            /* ── LAST PAGE (back cover) — Deepanjan (10th September 2026) ── */
            @page final-page {
                margin: 0mm;
                @top-center { content: normal; }
                @bottom-center { content: normal; }
            }

                        .cover-page-last {
                page: final-page;
                page-break-before: always;
                line-height: 0;
                font-size: 0;
                margin: 0;
                padding: 0;
            }
           
        </style>
    </head>
    <body>
       <apex:outputPanel layout="none" rendered="{!jsonData['MBCB_Type'] != 'Noise Barrier'}">
            <div class="cover-page">
                <img src="{!$Resource.CrashBarrierCover}" style="width: 100%; height: 296mm; display: block; margin: 0; padding: 0; border: none;" />
            </div>
        </apex:outputPanel>
        
        <div class="pdf-header">
            <table style="width: 100%; border-collapse: collapse; margin-bottom: 0; font-family: sans-serif; margin-top: 10mm;">
                <tr>
                    <td style="width: 100%; text-align: right; vertical-align: bottom; padding-bottom: 5px;">
                        <img src="{!$Resource.UtkarshHeader}" alt="Utkarsh header" style="width: 85%; height: auto;"/>
                    </td>
                </tr>
            </table>
        </div>

        

        <table style="width: 85%; font-size: 10px; font-weight: bold; margin-bottom: 25px;">
            <tr>
                <td style="text-align: left; text-decoration: underline;">REF: {!quoteRecord.Quote_Reference__c}</td>
                <td style="text-align: right; text-decoration: underline;">DATE: {!todayDate}</td>
            </tr>
        </table>
        <div style="margin-bottom: 20px; width: 85%;"><b>To,</b><br/>{!accountName}</div>
        <div style="margin-bottom: 20px; width: 85%;"><b>KIND ATTN: Mr/Ms. {!contactName}</b><br/><b>EMAIL ID: {!contactEmail}</b></div>
        <div style="margin-bottom: 20px; width: 85%;"><b>SUB: Our offer of "Utkarsh" Brand.</b></div>
       <div style="margin-bottom: 25px; line-height: 1.6; width: 85%; word-wrap: break-word; overflow-wrap: break-word;">
            Dear Madam / Sir<br/><br/>
            <span style="font-weight: bold;white-space: normal; display: inline;">Please refer to your enquiry &amp; the discussion had with Mr/Ms. {!$User.FirstName} {!$User.LastName}</span><br/>
        </div>

        <apex:variable var="rowNum" value="{!1}"/>

        <!-- ------NATRAX------ -->
        <apex:repeat value="{!lineItems}" var="row">

            <apex:outputPanel rendered="{!row['isMainProduct'] && CONTAINS(UPPER(row['name']), 'NATRAX')}">
                <div style="margin-top: 20px; font-weight: bold;  display: inline-block; padding: 3px 6px; font-size: 11px; page-break-after: avoid;">
                    <apex:outputText value="{!IF(CONTAINS(row['name'], 'Thrie'), 'NATRAX CRASH TESTED THRIE BEAM', 'NATRAX CRASH TESTED W BEAM')}"/>
                </div>
                <table style="width: 85%; border-collapse: collapse; border: 1px solid #000; font-family: sans-serif; font-size: 10px; table-layout: fixed; word-wrap: break-word; margin-bottom: -1px;">
                    <thead>
                        <tr style="background-color: #f2f2f2;">
                            <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 5%; font-weight: bold;">SL. NO.</th>
                            <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 45%; font-weight: bold;">ITEM DESCRIPTION</th>
                            <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 10%; font-weight: bold;">HSN Code</th>
                            <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 10%; font-weight: bold;">UNIT</th>
                            <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 10%; font-weight: bold;">QTY</th>
                            <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 10%; font-weight: bold;">RATE/MTR</th>
                            <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 10%; font-weight: bold;">AMOUNT</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="border: 1px solid #000; padding: 4px; text-align: center; vertical-align: top;">{!rowNum}</td>
                            <td style="border: 1px solid #000; padding: 4px; vertical-align: top;">
                                <strong>"Utkarsh"</strong> make <strong>{!IF(CONTAINS(row['name'], 'Thrie'), 'Thrie Beam', 'W Beam')}</strong> Metal Crash Barrier <strong>Single Side Single Beam</strong> guard rail comprising of <strong>{!IF(CONTAINS(row['name'], 'Thrie'), jsonData['tb_natrax_beam_thickness'], jsonData['wb_natrax_beam_thickness'])} MM</strong> having width of <strong>{!IF(CONTAINS(row['name'], 'Thrie'), '502', '312')} MM</strong> and depth <strong>83 MM</strong> with hot dip galvanized having total length <strong>4.318 MTR. (Effective length 4.0 MTR).</strong>
                            </td>
                            <td rowspan="5" style="border: 1px solid #000; padding: 4px; text-align: center; vertical-align: middle;">73089090</td>
                            <td rowspan="5" style="border: 1px solid #000; padding: 4px; text-align: center; vertical-align: middle;">MTR</td>
                            <td rowspan="5" style="border: 1px solid #000; padding: 4px; text-align: center; vertical-align: middle;">{!row['quantity']}</td>
                            <td rowspan="5" style="border: 1px solid #000; padding: 4px; text-align: right; vertical-align: middle;">
                                <apex:outputText value="{0, number, #,##0.00}"><apex:param value="{!row['unitPrice']}" /></apex:outputText>
                            </td>
                            <td rowspan="5" style="border: 1px solid #000; padding: 4px; text-align: right; vertical-align: middle;">
                                <apex:outputText value="{0, number, #,##0.00}"><apex:param value="{!row['quantity'] * row['unitPrice']}" /></apex:outputText>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid #000; padding: 4px; text-align: center; vertical-align: top;"><apex:outputText value="{!rowNum + 1}"/></td>
                            <td style="border: 1px solid #000; padding: 4px; vertical-align: top;">
                                Spacer channel made of <strong>"C"</strong> Section having hot dip galvanized having size of <strong>75 MM x 150 MM x 75 MM x {!IF(CONTAINS(row['name'], 'Thrie'), jsonData['tb_natrax_spacer_thickness'], jsonData['wb_natrax_spacer_thickness'])} MM thick x {!IF(CONTAINS(row['name'], 'Thrie'), jsonData['tb_natrax_spacer_length'], jsonData['wb_natrax_spacer_length'])} MM long.</strong>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid #000; padding: 4px; text-align: center; vertical-align: top;"><apex:outputText value="{!rowNum + 2}"/></td>
                            <td style="border: 1px solid #000; padding: 4px; vertical-align: top;">
                                Post channel made of <strong>"C"</strong> Section having hot dip galvanized having size of <strong>75 MM x 150 MM x 75 MM x {!IF(CONTAINS(row['name'], 'Thrie'), jsonData['tb_natrax_post_thickness'], jsonData['wb_natrax_post_thickness'])} MM thick x {!IF(CONTAINS(row['name'], 'Thrie'), jsonData['tb_natrax_post_height'], jsonData['wb_natrax_post_height'])} MM long</strong> with <strong>2.0 MTR</strong> center to center Post spacing.
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid #000; padding: 4px; text-align: center; vertical-align: top;"><apex:outputText value="{!rowNum + 3}"/></td>
                            <td style="border: 1px solid #000; padding: 4px; vertical-align: top;">
                                <strong>Required Fasteners (M16x40) Button Type for fixing as per: {!IF(CONTAINS(row['name'], 'Thrie'), jsonData['tb_natrax_nuts_bolts'], jsonData['wb_natrax_nuts_bolts'])}</strong>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid #000; padding: 4px; text-align: center; vertical-align: top;"><apex:outputText value="{!rowNum + 4}"/></td>
                            <td style="border: 1px solid #000; padding: 4px; vertical-align: top;">
                                <strong>Required Fasteners (M16x40) Hexagonal Type for fixing as per: {!IF(CONTAINS(row['name'], 'Thrie'), jsonData['tb_natrax_nuts_bolts'], jsonData['wb_natrax_nuts_bolts'])}</strong>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="7" style="border: 1px solid #000; padding: 4px; text-align: center; font-weight: bold; background-color: #f9f9f9;">
                                All thickness/weight tolerances as per IS standard/drawing applicable
                            </td>
                        </tr>
                        <apex:variable var="natraxFreight" value="{!IF(CONTAINS(row['name'], 'Thrie'), jsonData['tb_natrax_fvf'], jsonData['wb_natrax_fvf'])}" />
                        <apex:outputPanel layout="none" rendered="{!natraxFreight > 0}">
                            <tr>
                                <td colspan="6" style="border: 1px solid #000; padding: 4px; text-align: center; font-weight: bold;">Transportation charges</td>
                                <td style="border: 1px solid #000; padding: 4px; text-align: right;">
                                    <apex:outputText value="{0, number, #,##0.00}">
                                        <apex:param value="{!natraxFreight}" />
                                    </apex:outputText>
                                </td>
                            </tr>
                        </apex:outputPanel>
                        <apex:outputPanel layout="none" rendered="{!showSeperateInterest}">
                            <tr>
                                <td colspan="6" style="border: 1px solid #000; padding: 4px; text-align: center; font-weight: bold;">Interest Charges</td>
                                <td style="border: 1px solid #000; padding: 4px; text-align: right;">
                                    <apex:outputText value="{0, number, ##,##,##0.00}">
                                        <apex:param value="{!((row['quantity'] * row['unitPrice']) + natraxFreight) * (intrestfactor - 1)}" />
                                    </apex:outputText>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="6" style="border: 1px solid #000; padding: 4px; text-align: center; font-weight: bold;">Total charges</td>
                                <td style="border: 1px solid #000; padding: 4px; text-align: right;">
                                    <apex:outputText value="{0, number, ##,##,##0.00}">
                                        <apex:param value="{!((row['quantity'] * row['unitPrice']) + natraxFreight)  * intrestfactor}" />
                                    </apex:outputText>
                                </td>
                            </tr>
                        </apex:outputPanel>
                        <apex:outputPanel layout="none" rendered="{!NOT(showSeperateInterest)}">
                            <tr>
                                <td colspan="6" style="border: 1px solid #000; padding: 4px; text-align: center; font-weight: bold;">Total charges</td>
                                <td style="border: 1px solid #000; padding: 4px; text-align: right;">
                                    <apex:outputText value="{0, number, #,##0.00}">
                                        <apex:param value="{!(row['quantity'] * row['unitPrice']) + natraxFreight}" />
                                    </apex:outputText>
                                </td>
                            </tr>
                        </apex:outputPanel>
                    </tbody>
                </table>
                <apex:variable var="rowNum" value="{!rowNum + 5}"/>
            </apex:outputPanel>
        </apex:repeat>
			
        <!--------ALKA------- -->
        <apex:repeat value="{!lineItems}" var="row">
            <apex:outputPanel rendered="{!row['isMainProduct'] && CONTAINS(UPPER(row['name']), 'ALKA')}">
                <div style="margin-top: 20px; font-weight: bold;  display: inline-block; padding: 3px 6px; font-size: 11px; page-break-after: avoid;">
                    <apex:outputText value="{!IF(CONTAINS(row['name'], 'Thrie'), 'ALKA CRASH TESTED THRIE BEAM', 'ALKA CRASH TESTED W BEAM')}"/>
                </div>
                <table style="width: 85%; border-collapse: collapse; border: 1px solid #000; font-family: sans-serif; font-size: 10px; table-layout: fixed; word-wrap: break-word; margin-bottom: -1px;">
                    <thead>
                        <tr style="background-color: #f2f2f2;">
                            <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 5%; font-weight: bold;">SL. NO.</th>
                            <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 45%; font-weight: bold;">ITEM DESCRIPTION</th>
                            <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 10%; font-weight: bold;">HSN Code</th>
                            <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 8%; font-weight: bold;">UNIT</th>
                            <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 8%; font-weight: bold;">QTY</th>
                            <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 12%; font-weight: bold;">RATE/MTR</th>
                            <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 12%; font-weight: bold;">AMOUNT</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="border: 1px solid #000; padding: 4px; text-align: center; vertical-align: top;">{!rowNum}</td>
                            <td style="border: 1px solid #000; padding: 4px; vertical-align: top;">
                                <strong>"Utkarsh"</strong> make <strong>{!IF(CONTAINS(row['name'], 'Thrie'), 'Thrie Beam', 'W Beam')}</strong> Metal Crash Barrier <strong>Single Side Single Beam</strong> guard rail comprising of <strong>{!IF(CONTAINS(row['name'], 'Thrie'), jsonData['tb_alka_beam_thickness'], jsonData['wb_alka_beam_thickness'])} MM</strong> having width of <strong>{!IF(CONTAINS(row['name'], 'Thrie'), '502', '312')} MM</strong> and depth <strong>83 MM</strong> with hot dip galvanized having total length <strong>4.318 MTR. (Effective length 4.0 MTR).</strong>
                                <apex:outputPanel rendered="{!CONTAINS(row['name'], 'Thrie')}">
                                    <br/><span style=" font-weight: bold;">MATERIAL GRADE: E-250</span>
                                </apex:outputPanel>
                            </td>
                            <td rowspan="3" style="border: 1px solid #000; padding: 4px; text-align: center; vertical-align: middle;">73089090</td>
                            <td rowspan="3" style="border: 1px solid #000; padding: 4px; text-align: center; vertical-align: middle;">MTR</td>
                            <td rowspan="3" style="border: 1px solid #000; padding: 4px; text-align: center; vertical-align: middle;">{!row['quantity']}</td>
                            <td rowspan="3" style="border: 1px solid #000; padding: 4px; text-align: right; vertical-align: middle;">
                                <apex:outputText value="{0, number, #,##0.00}"><apex:param value="{!row['unitPrice']}" /></apex:outputText>
                            </td>
                            <td rowspan="3" style="border: 1px solid #000; padding: 4px; text-align: right; vertical-align: middle;">
                                <apex:outputText value="{0, number, #,##0.00}"><apex:param value="{!row['quantity'] * row['unitPrice']}" /></apex:outputText>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid #000; padding: 4px; text-align: center; vertical-align: top;"><apex:outputText value="{!rowNum + 1}"/></td>
                            <td style="border: 1px solid #000; padding: 4px; vertical-align: top;">
                                Post channel made of <strong>"C"</strong> Section having hot dip galvanized having size of <strong>{!IF(CONTAINS(row['name'], 'Thrie'), '125 MM x 62.5 MM', '62.5 MM x 125 MM')} x 25 MM x {!IF(CONTAINS(row['name'], 'Thrie'), jsonData['tb_alka_post_thickness'], jsonData['wb_alka_post_thickness'])} MM thick x {!IF(CONTAINS(row['name'], 'Thrie'), jsonData['tb_alka_post_height'], jsonData['wb_alka_post_height'])} MM long</strong> with <strong>{!IF(CONTAINS(row['name'], 'Thrie'), jsonData['tb_alka_centre_to_centre'], jsonData['wb_alka_centre_to_centre'])} MTR</strong> center to center Post spacing.
                                <apex:outputPanel rendered="{!CONTAINS(row['name'], 'Thrie')}">
                                    <br/><span style="font-weight: bold;">MATERIAL GRADE: E-350</span>
                                </apex:outputPanel>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid #000; padding: 4px; text-align: center; vertical-align: top;"><apex:outputText value="{!rowNum + 2}"/></td>
                            <td style="border: 1px solid #000; padding: 4px; vertical-align: top;">
                                <strong>Required Fasteners (M16x40) Button Type for fixing as per: {!IF(CONTAINS(row['name'], 'Thrie'), jsonData['tb_alka_nuts_bolts'], jsonData['wb_alka_nuts_bolts'])}</strong>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="7" style="border: 1px solid #000; padding: 4px; text-align: center; font-weight: bold; background-color: #f9f9f9;">
                                All thickness/weight tolerances as per IS standard/drawing applicable
                            </td>
                        </tr>
                       <apex:variable var="alkaFreight" value="{!IF(CONTAINS(row['name'], 'Thrie'), jsonData['tb_alka_fvf'], jsonData['wb_alka_fvf'])}" />
                        <apex:outputPanel layout="none" rendered="{!alkaFreight > 0}">
                            <tr>
                                <td colspan="6" style="border: 1px solid #000; padding: 4px; text-align: center; font-weight: bold;">Transportation charges</td>
                                <td style="border: 1px solid #000; padding: 4px; text-align: right;">
                                    <apex:outputText value="{0, number, #,##0.00}">
                                        <apex:param value="{!alkaFreight}" />
                                    </apex:outputText>
                                </td>
                            </tr>
                        </apex:outputPanel>

                        <apex:outputPanel layout="none" rendered="{!showSeperateInterest}">
                            <tr>
                                <td colspan="6" style="border: 1px solid #000; padding: 4px; text-align: center; font-weight: bold;">Interest Charges</td>
                                <td style="border: 1px solid #000; padding: 4px; text-align: right;">
                                    <apex:outputText value="{0, number, ##,##,##0.00}">
                                        <apex:param value="{!((row['quantity'] * row['unitPrice']) + alkaFreight) * (intrestfactor - 1)}" />
                                    </apex:outputText>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="6" style="border: 1px solid #000; padding: 4px; text-align: center; font-weight: bold;">Total charges</td>
                                <td style="border: 1px solid #000; padding: 4px; text-align: right;">
                                    <apex:outputText value="{0, number, ##,##,##0.00}">
                                        <apex:param value="{!((row['quantity'] * row['unitPrice']) + alkaFreight)  * intrestfactor}" />
                                    </apex:outputText>
                                </td>
                            </tr>
                        </apex:outputPanel>
                        <apex:outputPanel layout="none" rendered="{!NOT(showSeperateInterest)}">
                            <tr>
                                <td colspan="6" style="border: 1px solid #000; padding: 4px; text-align: center; font-weight: bold;">Total charges</td>
                                <td style="border: 1px solid #000; padding: 4px; text-align: right;">
                                    <apex:outputText value="{0, number, #,##0.00}">
                                        <apex:param value="{!(row['quantity'] * row['unitPrice']) + alkaFreight}" />
                                    </apex:outputText>
                                </td>
                            </tr>
                        </apex:outputPanel>
                    </tbody>
                </table>
                <apex:variable var="rowNum" value="{!rowNum + 3}"/>
            </apex:outputPanel>
        </apex:repeat>
        
       <!-- ========================================== -->
        <!-- NOISE BARRIER SECTION (ANNEXURE A) -->
        <!-- ========================================== -->
        <apex:repeat value="{!lineItems}" var="row">
            <apex:outputPanel rendered="{!row['isMainProduct'] && CONTAINS(UPPER(row['name']), 'NOISE BARRIER')}">
                
                <div style=" margin-bottom: 25px; line-height: 1.6; width: 85%; word-wrap: break-word; overflow-wrap: break-word; ">
                    Your enquiry for supplying of the product as mentioned in the captioned subject has given us this opportunity to connect and introduce our company and the “Utkarsh” brand and the various range of products of the company including and not limited to the <strong>“Noise Barriers”</strong>. We are obliged to have got this opportunity to submit our offer and/or quotation for manufacturing and supply of the product described in the captioned subject, as against your enquiry No. dated<strong> {!todayDate}</strong>.<br/><br/>
                    We take pride to mention that you have approached one of the leading brands in the country engaged in the manufacturing of the product as described herein and we can assure you that if you decide to accept our offer and place the purchase/supply order in our favor you will always feel proud for having made the right decision by relying upon the best quality product.<br/><br/>
                    Our offer and/or quotation for the Noise Barriers “Utkarsh” brand as enquired by you is/are more clearly mentioned and recorded in the Annexure “A” to this quotation. The said Annexure “A” shall for all practical purposes be considered as a part of the present quotation.
                </div>
                <div class="keepTogether">
                    <div style="text-align: right; margin-bottom: 5px; font-weight: bold; width: 85%;">
                        <span style=" padding: 2px 4px;">ANNEXURE - A</span>
                    </div>
                    <table style="width: 100%; border-collapse: collapse; border: 1px solid #000; font-family: sans-serif; font-size: 10px; table-layout: fixed; word-wrap: break-word; margin-bottom: 20px;">
                        <thead>
                            <tr style="background-color: #f2f2f2;">
                                <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 5%; font-weight: bold;">Sl. No.</th>
                                <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 45%; font-weight: bold;">Item Description</th>
                                
                                <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 15%; font-weight: bold;">
                                    Quantity {!IF(CONTAINS(UPPER(IF(CONTAINS(UPPER(row['name']), 'REFLECTIVE'), jsonData['r_s_uom'], jsonData['a_s_uom'])), 'SQ'), 'SMT', 'RMT')}
                                </th>
                                
                                <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 15%; font-weight: bold;">
                                    Rate IN {!IF(CONTAINS(UPPER(IF(CONTAINS(UPPER(row['name']), 'REFLECTIVE'), jsonData['r_s_uom'], jsonData['a_s_uom'])), 'SQ'), 'SMT', 'RMT')}
                                </th>
                                
                                <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 20%; font-weight: bold;">Amount</th>
                            </tr>
                        </thead>
