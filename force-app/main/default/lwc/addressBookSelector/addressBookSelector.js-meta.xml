<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Address Book Selector</masterLabel>

    <targets>
        <target>lightning__FlowScreen</target>
    </targets>

    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">

            <!-- Input from Flow -->
            <property
                name="accountId"
                type="String"
                label="Account Id"
                role="inputOnly"/>

            <!-- Output to Flow -->
            <property
                name="selectedAddressBookId"
                type="String"
                label="Selected Address Book Id"
                role="outputOnly"/>

        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>