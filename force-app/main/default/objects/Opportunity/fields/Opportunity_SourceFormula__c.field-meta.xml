<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Opportunity_SourceFormula__c</fullName>
    <description>This is to show in the layout and not editable, will receive value from Lead Source while conversion</description>
    <externalId>false</externalId>
    <formula>IF(
    NOT(ISBLANK(TEXT(Opportunity_Source__c))),
    TEXT(Opportunity_Source__c),
    TEXT(LeadSource)
)</formula>
    <label>Opportunity Source</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
