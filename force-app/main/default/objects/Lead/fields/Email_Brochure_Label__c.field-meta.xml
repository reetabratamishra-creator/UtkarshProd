<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Email_Brochure_Label__c</fullName>
    <description>Email brochure label: Corporate for Enquiry department, otherwise department name.</description>
    <externalId>false</externalId>
    <formula>IF(
  TEXT(Department_Name__c) = &quot;Enquiry&quot;,
  &quot;Corporate&quot;,
  TEXT(Department_Name__c)
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Email Brochure Label</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
