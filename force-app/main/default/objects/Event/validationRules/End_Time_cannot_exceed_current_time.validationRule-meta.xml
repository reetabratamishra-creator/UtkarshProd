<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>End_Time_cannot_exceed_current_time</fullName>
    <active>false</active>
    <errorConditionFormula>Actual_End_Time__c &gt; NOW()</errorConditionFormula>
    <errorDisplayField>Actual_End_Time__c</errorDisplayField>
    <errorMessage>Actual End Time cannot exceed current time</errorMessage>
</ValidationRule>
